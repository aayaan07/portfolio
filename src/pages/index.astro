---
import Layout from '../layouts/Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import Hero from '../components/Hero.astro';
import Stack from '../components/Stack.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Experience from '../components/Experience.astro';
import Games from '../components/Games.astro';
import Snapshots from '../components/Snapshots.astro';
import Spotify from '../components/Spotify.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import ForestFooter from '../components/ForestFooter.astro';
import Animations from '../components/Animations.astro';
---

<Layout title="Aayaan Kumar — Software Engineer / Gamer / Editor">
  <!-- Top Interactive Sky -->
  <SkyHeader height="190px" dotSize={3} />

  <main class="w-full max-w-[760px] mx-auto px-5 md:px-8 pt-4 sm:pt-6 flex-1">
    <div class="flex flex-col w-full">
      <Hero />
      <Stack />
      <SelectedWork />
      <Experience />
      <Games />
      <Snapshots />
      <Spotify />
      <ContactCTA />
    </div>
  </main>

  <Footer />

  <!-- Bottom Interactive Forest & Grazing Deer -->
  <ForestFooter height="270px" dotSize={3} />

  <Animations />
</Layout>
