---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Stack from '../components/Stack.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Experience from '../components/Experience.astro';
import Games from '../components/Games.astro';
import Snapshots from '../components/Snapshots.astro';
import Spotify from '../components/Spotify.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import Animations from '../components/Animations.astro';
---

<Layout title="Aayaan Kumar — Software Engineer / Gamer / Editor">
  <main class="w-full max-w-[760px] mx-auto px-5 md:px-8 pt-[248px] md:pt-[264px] flex-1">
    <div class="flex flex-col w-full">
      <Hero />
      <Stack />
      <SelectedWork />
      <Experience />
      <Games />
      <Snapshots />
      <Spotify />
      <ContactCTA />
    </div>
  </main>
  <Footer />
  <Animations />
</Layout>
