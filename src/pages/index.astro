---
import Layout from '../layouts/Layout.astro';
import SkyHeader from '../components/SkyHeader.astro';
import Hero from '../components/Hero.astro';
import Stack from '../components/Stack.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Experience from '../components/Experience.astro';
import Games from '../components/Games.astro';
import Snapshots from '../components/Snapshots.astro';
import Spotify from '../components/Spotify.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import ForestFooter from '../components/ForestFooter.astro';
import Animations from '../components/Animations.astro';
import WelcomeLoader from '../components/WelcomeLoader.astro';
---

<Layout title="Aayaan Kumar">
  <!-- Top Interactive Sky (remains visible during welcome loading) -->
  <SkyHeader height="190px" dotSize={3} />

  <!-- Center Welcome Calligraphy Loader (random 3s - 4.5s duration) -->
  <WelcomeLoader />

  <!-- Main Content Wrapper (hidden during loading, reveals when loader fades out) -->
  <div id="main-content" class="opacity-0 invisible pointer-events-none flex-1 flex flex-col justify-between">
    <main class="w-full max-w-[760px] mx-auto px-5 md:px-8 pt-4 sm:pt-6 flex-1">
      <div class="flex flex-col w-full">
        <Hero />
        <Stack />
        <SelectedWork />
        <Experience />
        <Games />
        <Snapshots />
        <Spotify />
        <ContactCTA />
      </div>
    </main>

    <Footer />

    <!-- Bottom Interactive Forest & Grazing Deer (hidden during loading) -->
    <ForestFooter height="270px" dotSize={3} />
  </div>

  <noscript>
    <style>
      #welcome-loader { display: none !important; }
      #main-content { opacity: 1 !important; visibility: visible !important; pointer-events: auto !important; }
    </style>
  </noscript>

  <Animations />
</Layout>
