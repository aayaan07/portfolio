---
// Hero / Intro Section
---

<section class="pb-[2.5rem] pt-[0.25rem] flex flex-col gap-[1.5rem]">
  <!-- Profile Header -->
  <div class="flex flex-col gap-4">
    <!-- Row 1: Image -->
    <div class="flex items-start">
      <div class="relative w-[110px] h-[110px] rounded-full overflow-hidden bg-[#eeeeee] flex-shrink-0 shadow-[0_6px_16px_rgba(0,0,0,0.12),inset_0_1px_0_rgba(255,255,255,0.8)] border-[2.5px] border-white">
        <img class="w-full h-full object-cover" alt="Aayaan Kumar avatar" src="/avatar.png" />
      </div>
    </div>

    <!-- Row 2: Name, Profession & Education -->
    <div class="flex flex-col gap-1">
      <span class="text-[22px] leading-[30px] tracking-[-0.015em] font-bold text-text-primary">Aayaan Kumar</span>
      <div class="flex flex-wrap items-center gap-x-2 text-[14px] leading-[22px] text-text-muted">
        <span class="font-medium text-text-primary">Software Engineer / Gamer / Editor</span>
        <span class="text-neutral-300">·</span>
        <span>Studying CSE at IILM University, Gurugram</span>
      </div>
    </div>
  </div>

  <!-- Manifesto -->
  <div class="flex flex-col gap-[1rem] pt-[0.25rem]" data-gsap="hero-text">
    <h1 class="text-[24px] leading-[32px] tracking-[-0.02em] font-semibold text-text-primary sm:leading-snug">
      Crafting intuitive digital products at the intersection of engineering rigor and meticulous interaction design.
    </h1>
    <p class="text-[17px] leading-[28px] tracking-[-0.01em] text-on-surface-variant max-w-[640px]">
      Second-year computer science student architecting resilient web systems, authoring open-source tooling, and sculpting tactile design languages. I care deeply about 60fps micro-interactions, type scale precision, and zero-compromise developer ergonomics.
    </p>
  </div>
</section>
