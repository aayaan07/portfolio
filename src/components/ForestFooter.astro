---
// src/components/ForestFooter.astro
interface Props {
  height?: string;
  dotSize?: number;
}

const { height = "560px", dotSize = 3 } = Astro.props;
---

<div
  class="forest-footer-art"
  style={`--forest-height: ${height};`}
  data-dot-size={dotSize}
>
  <canvas
    class="forest-canvas"
    aria-label="Interactive monochrome dotted forest with distant pine trees, foreground fir trees with bare lower trunks, leafless winter trees, wildflowers, waving grass, and a realistic stag deer"
  ></canvas>
</div>

<style>
  .forest-footer-art {
    position: relative;
    width: 100%;
    height: var(--forest-height, 560px);
    background: transparent;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    cursor: -webkit-image-set(url('/pointer.png') 1x, url('/pointer@2x.png') 2x) 1 1, url('/pointer.png') 1 1, auto !important;
    cursor: image-set(url('/pointer.png') 1x, url('/pointer@2x.png') 2x) 1 1, url('/pointer.png') 1 1, auto !important;
  }

  .forest-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: -webkit-image-set(url('/pointer.png') 1x, url('/pointer@2x.png') 2x) 1 1, url('/pointer.png') 1 1, auto !important;
    cursor: image-set(url('/pointer.png') 1x, url('/pointer@2x.png') 2x) 1 1, url('/pointer.png') 1 1, auto !important;
  }

  .forest-canvas[style*="cursor: pointer"],
  .forest-canvas[style*="cursor:pointer"],
  .forest-canvas[style*="cursor: grab"],
  .forest-canvas[style*="cursor:grab"],
  .forest-canvas[style*="cursor: grabbing"],
  .forest-canvas[style*="cursor:grabbing"] {
    cursor: -webkit-image-set(url('/hand-pointer.png') 1x, url('/hand-pointer@2x.png') 2x) 6 1, url('/hand-pointer.png') 6 1, pointer !important;
    cursor: image-set(url('/hand-pointer.png') 1x, url('/hand-pointer@2x.png') 2x) 6 1, url('/hand-pointer.png') 6 1, pointer !important;
  }
</style>

<script>
  import { playTapSound } from '../utils/sound';

  const BAYER_8X8 = [
    [ 0, 32,  8, 40,  2, 34, 10, 42],
    [48, 16, 56, 24, 50, 18, 58, 26],
    [12, 44,  4, 36, 14, 46,  6, 38],
    [60, 28, 52, 20, 62, 30, 54, 22],
    [ 3, 35, 11, 43,  1, 33,  9, 41],
    [51, 19, 59, 27, 49, 17, 57, 25],
    [15, 47,  7, 39, 13, 45,  5, 37],
    [63, 31, 55, 23, 61, 29, 53, 21]
  ];

  // Pre-computed monochrome shade LUT (0 = pitch black .. 255 = light grey)
  const SHADE_LUT: string[] = Array.from({ length: 256 }, (_, i) => `rgb(${i},${i},${i})`);

  // Grey helper: grey(40, 0.9) -> "rgba(40,40,40,0.9)"
  const grey = (s: number, a = 1) => {
    const v = Math.max(0, Math.min(255, Math.round(s)));
    return `rgba(${v},${v},${v},${a})`;
  };

  // =========================================================================
  // SHADE PALETTE  (0 = black ... 255 = white)
  // Every element gets its own place on the grey scale so the scene reads in
  // layers: far = light, mid = medium, near = dark, deer = darkest focal point.
  // Tweak any number here to re-balance the whole piece.
  // =========================================================================
  const PAL = {
    // Ground
    groundTop: 58,
    groundBottom: 24,

    // Deer (kept darkest so it pops, with lighter belly / far legs / rump)
    deerBody: 12,
    deerNeck: 16,
    deerHead: 14,
    deerTail: 26,
    deerLegNear: 16,
    deerLegFar: 92,
    deerBelly: 112,
    deerRump: 170,
    deerEarBack: 104,
    deerEarFront: 18,
    deerAntlerFar: 112,
    deerAntlerNear: 10,
    deerHoof: 6,

    // Misc
    bird: 14,
    sprout: 44,
    sproutLeaf: 26
  };

  interface TrunkPt {
    x: number; // offset from tree.x
    y: number; // offset from ground (negative = up)
    w: number; // full trunk width at this point
  }

  interface Limb {
    x1: number;
    y1: number;
    x2: number;
    y2: number;
    w: number;
  }

  // Interpolate along a trunk polyline (u: 0 = ground .. 1 = top)
  function trunkAt(trunk: TrunkPt[], u: number): TrunkPt {
    const f = Math.max(0, Math.min(0.9999, u)) * (trunk.length - 1);
    const i = Math.floor(f);
    const k = f - i;
    const a = trunk[i];
    const b = trunk[i + 1];
    return {
      x: a.x + (b.x - a.x) * k,
      y: a.y + (b.y - a.y) * k,
      w: a.w + (b.w - a.w) * k
    };
  }

  // Build a sparse, leafless tree: one tapering trunk, a handful of angular limbs
  function buildBareTree(h: number, tw: number, curve: number) {
    const trunk: TrunkPt[] = [];
    const steps = 8;
    for (let j = 0; j <= steps; j++) {
      const u = j / steps;
      trunk.push({
        x: curve * Math.sin(u * Math.PI * 0.85) + (j > 0 ? (Math.random() - 0.5) * 1.2 : 0),
        y: -h * 0.94 * u,
        w: j === 0 ? tw * 1.35 : tw * (1 - 0.86 * u) // root flare, then taper
      });
    }

    const limbs: Limb[] = [];
    const count = 4 + (Math.random() < 0.5 ? 1 : 0);
    let side = Math.random() < 0.5 ? -1 : 1;
    let perch = { ox: 0, oy: -h * 0.7 };

    for (let b = 0; b < count; b++) {
      const u = 0.42 + (b / (count - 1)) * 0.46 + (Math.random() - 0.5) * 0.04;
      const o = trunkAt(trunk, u);
      const len = h * (0.3 - 0.17 * u) * (0.85 + Math.random() * 0.3);
      const ang = side * (0.55 + Math.random() * 0.45);
      const th = Math.max(1.1, tw * 0.36 * (1 - u * 0.45));

      // Limb: shoulder -> elbow -> tip, curling upward
      const mx = o.x + Math.sin(ang) * len * 0.55;
      const my = o.y - Math.cos(ang) * len * 0.55;
      const ang2 = ang * 0.55;
      const ex = mx + Math.sin(ang2) * len * 0.45;
      const ey = my - Math.cos(ang2) * len * 0.45;

      limbs.push({ x1: o.x, y1: o.y, x2: mx, y2: my, w: th });
      limbs.push({ x1: mx, y1: my, x2: ex, y2: ey, w: th * 0.72 });

      // One single fork off the elbow
      const fAng = -side * 0.12;
      limbs.push({
        x1: mx,
        y1: my,
        x2: mx + Math.sin(fAng) * len * 0.32,
        y2: my - Math.cos(fAng) * len * 0.32,
        w: th * 0.55
      });

      // Occasionally a tiny split at the tip
      if (Math.random() < 0.6) {
        for (const d of [-0.6, 0.6]) {
          limbs.push({
            x1: ex,
            y1: ey,
            x2: ex + Math.sin(ang2 + d) * len * 0.2,
            y2: ey - Math.cos(ang2 + d) * len * 0.2,
            w: th * 0.4
          });
        }
      }

      perch = { ox: ex, oy: ey };
      side = -side;
    }

    // Forked leader at the very top
    const top = trunk[trunk.length - 1];
    limbs.push({ x1: top.x, y1: top.y, x2: top.x + 3.5, y2: top.y - 7, w: 1.1 });
    limbs.push({ x1: top.x, y1: top.y, x2: top.x - 3, y2: top.y - 5.5, w: 1 });

    const marks: { u: number; side: number }[] = [];
    for (let n = 0; n < 7; n++) {
      marks.push({ u: 0.06 + (n / 7) * 0.55, side: n % 2 === 0 ? -1 : 1 });
    }

    return { trunk, limbs, marks, perch };
  }

  // Bottom zigzag edge of one fir tier, from right corner to left corner
  function tierEdge(cx: number, baseY: number, hw: number, th: number) {
    const S = hw > 22 ? 8 : hw > 12 ? 6 : 4;
    const pts: [number, number][] = [];
    for (let k = 0; k <= S; k++) {
      const x = cx + hw - (2 * hw * k) / S;
      pts.push([x, k % 2 === 0 ? baseY + th * 0.07 : baseY - th * 0.16]);
    }
    return pts;
  }

  function fillPoly(c: CanvasRenderingContext2D, pts: [number, number][], fill: string) {
    c.beginPath();
    c.moveTo(pts[0][0], pts[0][1]);
    for (let i = 1; i < pts.length; i++) c.lineTo(pts[i][0], pts[i][1]);
    c.closePath();
    c.fillStyle = fill;
    c.fill();
  }

  function initForestFooter(wrapper: HTMLElement) {
    if (wrapper.dataset.ready === "true") return;
    wrapper.dataset.ready = "true";

    const canvas = wrapper.querySelector(".forest-canvas") as HTMLCanvasElement;
    const ctx = canvas.getContext("2d", { alpha: true })!;

    const offCanvas = document.createElement("canvas");
    const offCtx = offCanvas.getContext("2d", { willReadFrequently: true })!;

    const CELL = Math.max(2, Number(wrapper.dataset.dotSize) || 3);
    let cols = 0;
    let rows = 0;
    let time = 0;

    const pointer = { x: -999, y: -999, vx: 0, vy: 0, active: false };

    // 1. Distant Background Pine Trees (Far away misty silhouette)
    interface BackPine {
      x: number;
      h: number;
      w: number;
      tiers: number;
      sway: number;
      vSway: number;
    }

    // 2. Foreground trees: "fir" (bare lower trunk, tiered christmas-tree crown
    //    starting around the middle) and "bare" (leafless, few limbs)
    interface FrontTree {
      x: number;
      kind: "fir" | "bare";
      h: number;
      w: number;
      trunkWidth: number;
      trunkCurve: number;
      sway: number;
      vSway: number;
      barkShade: number;
      // fir
      foliageStart: number; // fraction of height where the first tier begins
      tiers: number;
      foliageShade: number;
      // bare
      trunk: TrunkPt[];
      limbs: Limb[];
      marks: { u: number; side: number }[];
      // where startled birds burst out from (relative to tree.x / ground)
      perch: { ox: number; oy: number };
    }

    interface Plant {
      x: number;
      type: "fern" | "flower" | "bush";
      size: number;
      bend: number;
      vBend: number;
      hasSeeds: boolean;
      tone: number; // per-plant shade offset
    }

    interface GrassBlade {
      x: number;
      h: number;
      angle: number;
      vAngle: number;
      stiff: number;
      layer: "back" | "front";
      phase: number;
      shade: number;
    }

    interface Spore {
      x: number;
      y: number;
      vx: number;
      vy: number;
      shade: number;
      life: number;
      maxLife: number;
    }

    interface PerchedBird {
      x: number;
      y: number;
      vx: number;
      vy: number;
      treeIdx: number;
      flying: boolean;
      wingPhase: number;
    }

    interface Ripple {
      x: number;
      y: number;
      r: number;
      alpha: number;
      shade: number;
    }

    interface Sparkle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      life: number;
      maxLife: number;
      shade: number;
    }

    let backPines: BackPine[] = [];
    let frontTrees: FrontTree[] = [];
    let plants: Plant[] = [];
    let grass: GrassBlade[] = [];
    let spores: Spore[] = [];
    let ripples: Ripple[] = [];
    let sparkles: Sparkle[] = [];
    let birds: PerchedBird[] = [];
    let treats: SproutTreat[] = [];

    const DEER_SCALE = 1.91;
    const deer = {
      x: 120,
      dir: 1,
      state: "grazing" as "grazing" | "walking" | "alert" | "trotting",
      stateTimer: 180,
      targetX: 180,
      walkCycle: 0,
      speed: 0,
      neckProgress: 1,
      earFlick: 0,
      tailFlick: 0,
      chewPhase: 0
    };

    function buildForest() {
      // =========================================================================
      // 1. DISTANT BACKGROUND PINE TREES (unchanged)
      // =========================================================================
      backPines = [];
      const pineCount = Math.max(10, Math.floor(cols / 28));
      for (let i = 0; i < pineCount; i++) {
        const maxH = Math.min(165, rows * 0.78);
        const h = maxH * (0.52 + Math.sin(i * 1.7) * 0.18 + Math.random() * 0.22);
        backPines.push({
          x: (cols / pineCount) * (i + 0.35) + (Math.random() - 0.5) * 14,
          h,
          w: h * 0.38,
          tiers: 5,
          sway: 0,
          vSway: 0
        });
      }

      // =========================================================================
      // 2. FOREGROUND TREES: firs (crown starts mid-trunk) + leafless trees
      // =========================================================================
      frontTrees = [];
      const frontCount = Math.max(5, Math.floor(cols / 64));
      const pattern: FrontTree["kind"][] = ["fir", "bare", "fir", "fir", "bare", "fir", "bare", "fir"];
      let bareIdx = 0;

      for (let i = 0; i < frontCount; i++) {
        const kind = pattern[i % pattern.length];
        const maxH = Math.min(210, rows * 0.94);
        const x = (cols / frontCount) * (i + 0.5) + (Math.random() - 0.5) * 20;

        if (kind === "fir") {
          const h = maxH * (0.86 + Math.random() * 0.14);
          const w = h * (0.4 + Math.random() * 0.1);
          const foliageStart = 0.4 + Math.random() * 0.1; // trunk is bare for the lower 40-50%
          const tiers = 6 + Math.floor(Math.random() * 3);

          frontTrees.push({
            x,
            kind,
            h,
            w,
            trunkWidth: 7 + Math.random() * 2,
            trunkCurve: (Math.random() - 0.5) * 3,
            sway: 0,
            vSway: 0,
            barkShade: 30 + Math.floor(Math.random() * 14),
            foliageStart,
            tiers,
            foliageShade: 44 + Math.floor(Math.random() * 26),
            trunk: [],
            limbs: [],
            marks: [],
            perch: {
              ox: (Math.random() - 0.5) * w * 0.3,
              oy: -h * (foliageStart + (1 - foliageStart) * 0.5)
            }
          });
        } else {
          const h = maxH * (0.74 + Math.random() * 0.16);
          const w = h * (0.5 + Math.random() * 0.1);
          const trunkWidth = 8 + Math.random() * 2.5;
          const trunkCurve = (Math.random() - 0.5) * 8;
          const geo = buildBareTree(h, trunkWidth, trunkCurve);
          const pale = bareIdx % 2 === 1; // alternate dark trunks and pale birch-like trunks
          bareIdx++;

          frontTrees.push({
            x,
            kind,
            h,
            w,
            trunkWidth,
            trunkCurve,
            sway: 0,
            vSway: 0,
            barkShade: pale ? 128 + Math.floor(Math.random() * 14) : 40 + Math.floor(Math.random() * 12),
            foliageStart: 1,
            tiers: 0,
            foliageShade: 0,
            trunk: geo.trunk,
            limbs: geo.limbs,
            marks: geo.marks,
            perch: geo.perch
          });
        }
      }

      // 3. Birds hidden ONLY in foliaged ("fir") foreground trees (leafless "bare" trees have no birds)
      birds = frontTrees
        .map((t, i) => ({ t, i }))
        .filter(({ t }) => t.kind === "fir")
        .map(({ t, i }) => ({
          x: t.x + t.perch.ox,
          y: rows - 4 + t.perch.oy,
          vx: 0,
          vy: 0,
          treeIdx: i,
          flying: false,
          wingPhase: Math.random() * Math.PI * 2
        }));

      // 4. Forest plants & wildflowers
      plants = [];
      const plantCount = Math.max(14, Math.floor(cols / 19));
      const types: Plant["type"][] = ["fern", "flower", "bush"];
      for (let i = 0; i < plantCount; i++) {
        const type = types[i % 3];
        plants.push({
          x: (cols / plantCount) * (i + 0.5) + (Math.random() - 0.5) * 10,
          type,
          size: (9 + Math.random() * 6) * 1.5,
          bend: 0,
          vBend: 0,
          hasSeeds: type === "flower",
          tone: -10 + Math.random() * 24
        });
      }

      // 5. Meadow grass: back blades are light, front blades span dark to mid grey
      grass = [];
      const bladeCount = Math.floor(cols * 1.75);
      for (let i = 0; i < bladeCount; i++) {
        const isFront = i % 3 === 0;
        grass.push({
          x: (i / bladeCount) * cols + (Math.random() - 0.5) * 1.5,
          h: (isFront ? 10 : 7) + Math.random() * 7,
          angle: 0,
          vAngle: 0,
          stiff: 0.08 + Math.random() * 0.05,
          layer: isFront ? "front" : "back",
          phase: Math.random() * Math.PI * 2,
          shade: isFront ? 18 + Math.random() * 52 : 98 + Math.random() * 36
        });
      }

      deer.x = cols * 0.36;
      deer.targetX = cols * 0.64;
    }

    function resize() {
      const rect = wrapper.getBoundingClientRect();
      const w = Math.max(300, Math.floor(rect.width));
      const h = Math.max(320, Math.floor(rect.height));
      canvas.width = w;
      canvas.height = h;
      cols = Math.floor(w / CELL);
      rows = Math.floor(h / CELL);
      offCanvas.width = cols;
      offCanvas.height = rows;
      buildForest();
    }

    const ro = new ResizeObserver(resize);
    ro.observe(wrapper);
    resize();

    function spawnSpores(x: number, y: number, count: number, shade = 60) {
      for (let i = 0; i < count; i++) {
        spores.push({
          x: x + (Math.random() - 0.5) * 6,
          y: y + (Math.random() - 0.5) * 6,
          vx: (Math.random() - 0.3) * 0.45,
          vy: -0.25 - Math.random() * 0.4,
          shade: Math.max(0, Math.min(255, shade + (Math.random() - 0.5) * 40)),
          life: 0,
          maxLife: 45 + Math.random() * 40
        });
      }
    }

    function spawnSparkles(x: number, y: number, count = 8) {
      for (let i = 0; i < count; i++) {
        const ang = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.45;
        const spd = 0.45 + Math.random() * 0.95;
        sparkles.push({
          x,
          y,
          vx: Math.cos(ang) * spd,
          vy: Math.sin(ang) * spd - 0.25,
          size: 1.1 + Math.random() * 1.5,
          life: 0,
          maxLife: 26 + Math.floor(Math.random() * 20),
          shade: 35 + Math.floor(Math.random() * 45)
        });
      }
    }

    // Pointer Interactions
    canvas.addEventListener("pointermove", (e) => {
      const rect = canvas.getBoundingClientRect();
      const cx = (e.clientX - rect.left) / CELL;
      const cy = (e.clientY - rect.top) / CELL;
      pointer.vx = cx - pointer.x;
      pointer.vy = cy - pointer.y;
      pointer.x = cx;
      pointer.y = cy;
      pointer.active = true;

      const groundY = rows - 4;

      // 1. Shake foreground trees & scatter hidden birds (birds only in "fir" trees)
      for (let i = 0; i < frontTrees.length; i++) {
        const t = frontTrees[i];
        const lowFrac = t.kind === "fir" ? t.foliageStart * 0.9 : 0.4;
        if (Math.abs(cx - t.x) < t.w * 0.55 && cy > groundY - t.h && cy < groundY - t.h * lowFrac) {
          t.vSway += Math.max(-0.35, Math.min(0.35, pointer.vx * 0.035));
          if (Math.hypot(pointer.vx, pointer.vy) > 1.8) {
            if (t.kind === "fir") {
              spawnSpores(cx, cy, 1, 56);
              for (const b of birds) {
                if (!b.flying && b.treeIdx === i) {
                  b.flying = true;
                  b.vx = (Math.random() > 0.5 ? 1 : -1) * (0.42 + Math.random() * 0.3);
                  b.vy = -0.42 - Math.random() * 0.25;
                }
              }
            }
          }
        }
      }

      // 2. Gentle sway on distant background pines
      for (const bp of backPines) {
        if (Math.abs(cx - bp.x) < bp.w * 0.5 && cy > groundY - bp.h) {
          bp.vSway += Math.max(-0.2, Math.min(0.2, pointer.vx * 0.02));
        }
      }

      // 3. Sweep flowers/plants & release dandelion spores
      for (const p of plants) {
        if (Math.abs(cx - p.x) < 12 && cy > groundY - p.size - 8) {
          p.vBend += Math.max(-0.4, Math.min(0.4, pointer.vx * 0.045));
          if (p.hasSeeds && Math.abs(pointer.vx) > 0.8 && Math.random() < 0.45) {
            spawnSpores(p.x, groundY - p.size, 3, 70);
          }
        }
      }

      // 4. Sweep meadow grass
      for (const g of grass) {
        const dx = Math.abs(g.x - cx);
        if (dx < 10 && cy > groundY - g.h - 6) {
          g.vAngle += Math.max(-0.4, Math.min(0.4, pointer.vx * 0.05 * (1 - dx / 10)));
        }
      }

      const nearDeer = Math.abs(cx - deer.x) < 26 && cy > groundY - 54;
      canvas.style.cursor = nearDeer ? "pointer" : "default";
    });

    canvas.addEventListener("pointerleave", () => {
      pointer.active = false;
      canvas.style.cursor = "default";
    });

    canvas.addEventListener("pointerdown", (e) => {
      const rect = canvas.getBoundingClientRect();
      const cx = (e.clientX - rect.left) / CELL;
      const cy = (e.clientY - rect.top) / CELL;
      const groundY = rows - 4;

      playTapSound(0.45);

      // Trigger sparkle and expanding ripple effect on click
      ripples.push({ x: cx, y: cy, r: 2, alpha: 0.85, shade: 45 });
      spawnSparkles(cx, cy, 9);

      // 1. Click on the stag -> playful bounding trot
      if (Math.abs(cx - deer.x) < 26 && cy > groundY - 54) {
        deer.state = "trotting";
        const jumpDir = deer.x < cols * 0.5 ? 1 : -1;
        deer.dir = jumpDir;
        deer.targetX = Math.max(45, Math.min(cols - 45, deer.x + jumpDir * (55 + Math.random() * 45)));
        deer.earFlick = 1;
        deer.tailFlick = 1;
        spawnSpores(deer.x, groundY - 8, 8, 40);
        return;
      }

      // 2. Click on the meadow -> sprout a plant that calls the deer over to graze
      if (cy > groundY - 55) {
        const clampedX = Math.max(40, Math.min(cols - 40, cx));
        treats.push({ x: clampedX, growth: 0.1 });
        const mouthReach = 14.5 * DEER_SCALE;
        deer.targetX = clampedX - (clampedX > deer.x ? mouthReach : -mouthReach);
        deer.dir = clampedX >= deer.x ? 1 : -1;
        deer.state = "walking";
        spawnSpores(clampedX, groundY - 4, 5, 50);
      }
    });

    // Distant background pine (unchanged: misty light-ash grey, low opacity)
    function drawBackPine(c: CanvasRenderingContext2D, bp: BackPine, groundY: number) {
      c.strokeStyle = "rgba(140, 140, 148, 0.45)";
      c.lineWidth = 3.2;
      c.beginPath();
      c.moveTo(bp.x, groundY);
      c.lineTo(bp.x + bp.sway, groundY - bp.h * 0.4);
      c.stroke();

      for (let i = 0; i < bp.tiers; i++) {
        const frac = i / bp.tiers;
        const tierSway = bp.sway * (1 + i * 0.8);
        const topY = groundY - bp.h + (1 - (i + 1) / bp.tiers) * (bp.h * 0.78);
        const botY = groundY - bp.h * 0.14 - frac * (bp.h * 0.62);
        const halfW = bp.w * (0.55 - frac * 0.34);

        const grad = c.createLinearGradient(bp.x, topY, bp.x, botY);
        grad.addColorStop(0, "rgba(148, 148, 156, 0.46)");
        grad.addColorStop(1, "rgba(168, 168, 175, 0.18)");

        c.fillStyle = grad;
        c.beginPath();
        c.moveTo(bp.x + tierSway * 1.2, topY);
        c.lineTo(bp.x + halfW + tierSway * 0.6, botY);
        c.lineTo(bp.x - halfW + tierSway * 0.6, botY);
        c.closePath();
        c.fill();
      }
    }

    // Christmas-tree style fir: bare trunk below, stacked jagged tiers from mid-height up
    function drawFir(c: CanvasRenderingContext2D, t: FrontTree, groundY: number) {
      const SWAY = 3.2;
      const lean = (ly: number) => t.sway * SWAY * (ly / t.h);
      const xAt = (ly: number) => t.x + t.trunkCurve * (ly / t.h) + lean(ly);

      // --- Trunk (bare for the lower half) ---
      const trunkTop = t.h * 0.92;
      const midLy = trunkTop * 0.5;
      const tw = t.trunkWidth;
      const topX = xAt(trunkTop);
      const midX = xAt(midLy);
      const topY = groundY - trunkTop;
      const midY = groundY - midLy;

      c.fillStyle = grey(t.barkShade, 0.97);
      c.beginPath();
      c.moveTo(t.x - tw * 0.95, groundY);
      c.quadraticCurveTo(midX - tw * 0.4, midY, topX - tw * 0.2, topY);
      c.lineTo(topX + tw * 0.2, topY);
      c.quadraticCurveTo(midX + tw * 0.4, midY, t.x + tw * 0.95, groundY);
      c.closePath();
      c.fill();

      c.lineCap = "round";
      c.lineJoin = "round";

      // Lit left edge
      c.strokeStyle = grey(t.barkShade + 44, 0.85);
      c.lineWidth = 1.1;
      c.beginPath();
      c.moveTo(t.x - tw * 0.7, groundY);
      c.quadraticCurveTo(midX - tw * 0.3, midY, topX - tw * 0.15, topY);
      c.stroke();

      // Shadowed right edge
      c.strokeStyle = grey(t.barkShade - 22, 0.98);
      c.lineWidth = 1.7;
      c.beginPath();
      c.moveTo(t.x + tw * 0.75, groundY);
      c.quadraticCurveTo(midX + tw * 0.33, midY, topX + tw * 0.15, topY);
      c.stroke();

      // Bark ridges on the visible lower trunk
      c.strokeStyle = grey(t.barkShade - 20, 0.9);
      c.lineWidth = 1.05;
      const visibleLy = t.h * t.foliageStart;
      for (let n = 0; n < 6; n++) {
        const ly = visibleLy * (0.1 + (n / 6) * 0.85);
        const side = n % 2 === 0 ? -1 : 1;
        const x = xAt(ly);
        const wHere = tw * (1 - (ly / trunkTop) * 0.55) * 0.5;
        const y = groundY - ly;
        c.beginPath();
        c.moveTo(x + side * wHere * 0.2, y);
        c.lineTo(x + side * wHere * 0.9, y + 3);
        c.stroke();
      }

      // --- Tiers, bottom to top, each one overlapping the one below ---
      const N = t.tiers;
      const F = t.h * (1 - t.foliageStart);
      const th = F / (1 + 0.58 * (N - 1));

      for (let i = 0; i < N; i++) {
        const baseLy = t.h * t.foliageStart + i * 0.58 * th;
        const topLy = baseLy + th;
        const baseY = groundY - baseLy;
        const apexY = groundY - topLy;
        const cx = xAt(baseLy);
        const ax = xAt(topLy);
        const hw = t.w * 0.5 * (1 - (0.78 * i) / N);

        // Tiers get slightly lighter toward the top, with alternating banding
        const sh = t.foliageShade + (i % 2) * 8 + (i / Math.max(1, N - 1)) * 14;

        const edge = tierEdge(cx, baseY, hw, th);
        const mid = Math.floor(edge.length / 2);

        // Dark skirt under the tier for depth
        fillPoly(
          c,
          [[ax, apexY + th * 0.4], ...edge.map(([x, y]) => [x, y + th * 0.14] as [number, number])],
          grey(sh - 30, 0.9)
        );
        // Shadow side (full silhouette)
        fillPoly(c, [[ax, apexY], ...edge], grey(sh - 8, 0.95));
        // Lit left half
        fillPoly(c, [[ax, apexY], ...edge.slice(mid)], grey(sh + 22, 0.95));

        // Bright rim along the left slope
        c.strokeStyle = grey(sh + 52, 0.7);
        c.lineWidth = 1;
        c.beginPath();
        c.moveTo(ax, apexY);
        c.lineTo(edge[edge.length - 1][0], edge[edge.length - 1][1]);
        c.stroke();
      }

      // Little leader at the tip
      const tipX = xAt(t.h);
      c.strokeStyle = grey(t.barkShade + 6, 0.95);
      c.lineWidth = 1.4;
      c.beginPath();
      c.moveTo(tipX, groundY - t.h + 1);
      c.lineTo(tipX + 0.5, groundY - t.h - 5);
      c.stroke();
    }

    // Leafless tree: tapering trunk with a handful of angular limbs
    function drawBareTree(c: CanvasRenderingContext2D, t: FrontTree, groundY: number) {
      const SWAY = 3.0;
      const at = (lx: number, ly: number): [number, number] => [
        t.x + lx + t.sway * SWAY * (-ly / t.h),
        groundY + ly
      ];
      const pale = t.barkShade > 90;

      const L: [number, number][] = [];
      const R: [number, number][] = [];
      for (const p of t.trunk) {
        const [x, y] = at(p.x, p.y);
        L.push([x - p.w / 2, y]);
        R.push([x + p.w / 2, y]);
      }

      // Trunk body
      c.fillStyle = grey(t.barkShade, 0.97);
      c.beginPath();
      c.moveTo(L[0][0], L[0][1]);
      for (let i = 1; i < L.length; i++) c.lineTo(L[i][0], L[i][1]);
      for (let i = R.length - 1; i >= 0; i--) c.lineTo(R[i][0], R[i][1]);
      c.closePath();
      c.fill();

      c.lineCap = "round";
      c.lineJoin = "round";

      // Lit left edge
      c.strokeStyle = grey(t.barkShade + (pale ? 36 : 40), 0.9);
      c.lineWidth = 1.1;
      c.beginPath();
      c.moveTo(L[0][0] + 0.6, L[0][1]);
      for (let i = 1; i < L.length; i++) c.lineTo(L[i][0] + 0.5, L[i][1]);
      c.stroke();

      // Shadowed right edge
      c.strokeStyle = grey(t.barkShade - (pale ? 62 : 28), 0.97);
      c.lineWidth = 1.7;
      c.beginPath();
      c.moveTo(R[0][0] - 0.7, R[0][1]);
      for (let i = 1; i < R.length; i++) c.lineTo(R[i][0] - 0.6, R[i][1]);
      c.stroke();

      // Bark marks: dark dashes on pale trunks, craggy ridges on dark ones
      c.strokeStyle = grey(pale ? 34 : t.barkShade - 24, 0.95);
      c.lineWidth = pale ? 1.4 : 1.1;
      for (const m of t.marks) {
        const pos = trunkAt(t.trunk, m.u);
        const [x, y] = at(pos.x, pos.y);
        c.beginPath();
        c.moveTo(x + m.side * pos.w * 0.08, y);
        c.lineTo(x + m.side * pos.w * 0.46, y + (pale ? 0 : 2.5));
        c.stroke();
      }

      // Limbs
      c.strokeStyle = grey(t.barkShade + (pale ? -14 : 12), 0.96);
      for (const l of t.limbs) {
        const [x1, y1] = at(l.x1, l.y1);
        const [x2, y2] = at(l.x2, l.y2);
        c.lineWidth = l.w;
        c.beginPath();
        c.moveTo(x1, y1);
        c.lineTo(x2, y2);
        c.stroke();
      }
    }

    // Botanical plants (ferns, wildflowers, berry shrubs) with per-plant shade
    function drawPlant(c: CanvasRenderingContext2D, p: Plant, groundY: number) {
      c.save();
      c.translate(p.x, groundY);

      if (p.type === "fern") {
        const s = 62 + p.tone;
        c.strokeStyle = grey(s, 0.92);
        c.lineWidth = 1.35;
        for (let f = -2; f <= 2; f++) {
          const angle = f * 0.34 + p.bend;
          const len = p.size * (1 - Math.abs(f) * 0.15);
          const tipX = Math.sin(angle) * len;
          const tipY = -Math.cos(angle) * len;
          c.beginPath();
          c.moveTo(0, 0);
          c.quadraticCurveTo(tipX * 0.5, tipY * 0.8, tipX, tipY);
          c.stroke();

          c.fillStyle = grey(s - 16, 0.9);
          for (let l = 0.3; l <= 0.88; l += 0.2) {
            c.fillRect(tipX * l - 2.1, tipY * l - 0.8, 4.2, 1.6);
          }
        }
      } else if (p.type === "flower") {
        const tipX = Math.sin(p.bend) * p.size;
        const tipY = -Math.cos(p.bend) * p.size;

        c.globalCompositeOperation = "destination-out";
        c.fillStyle = "rgba(0, 0, 0, 0.75)";
        c.beginPath();
        c.arc(tipX, tipY, 6.8, 0, Math.PI * 2);
        c.fill();
        c.globalCompositeOperation = "source-over";

        c.strokeStyle = grey(76 + p.tone, 0.94);
        c.lineWidth = 1.45;
        c.beginPath();
        c.moveTo(0, 0);
        c.quadraticCurveTo(tipX * 0.4, tipY * 0.6, tipX, tipY);
        c.moveTo(tipX * 0.35, tipY * 0.45);
        c.lineTo(tipX * 0.35 - 4.5, tipY * 0.45 - 3.5);
        c.moveTo(tipX * 0.55, tipY * 0.65);
        c.lineTo(tipX * 0.55 + 4.5, tipY * 0.65 - 3.5);
        c.stroke();

        c.fillStyle = grey(22, 0.98);
        for (let a = 0; a < 5; a++) {
          const ang = (a / 5) * Math.PI * 2 + time * 0.2;
          const px = tipX + Math.cos(ang) * 3.2;
          const py = tipY + Math.sin(ang) * 3.2;
          c.beginPath();
          c.arc(px, py, 2.4, 0, Math.PI * 2);
          c.fill();
        }
        c.globalCompositeOperation = "destination-out";
        c.beginPath();
        c.arc(tipX, tipY, 1.5, 0, Math.PI * 2);
        c.fill();
        c.globalCompositeOperation = "source-over";
      } else {
        const g = c.createRadialGradient(
          p.bend * 2,
          -p.size * 0.4,
          1,
          0,
          -p.size * 0.38,
          p.size * 0.85
        );
        g.addColorStop(0, grey(80 + p.tone, 0.88));
        g.addColorStop(1, grey(108 + p.tone, 0));
        c.fillStyle = g;
        c.beginPath();
        c.arc(p.bend * 1.5, -p.size * 0.38, p.size * 0.85, 0, Math.PI * 2);
        c.fill();

        c.fillStyle = grey(20, 0.98);
        c.beginPath();
        c.arc(-3.5, -p.size * 0.52, 1.8, 0, Math.PI * 2);
        c.arc(2.5, -p.size * 0.38, 1.8, 0, Math.PI * 2);
        c.arc(-0.5, -p.size * 0.25, 1.8, 0, Math.PI * 2);
        c.fill();
      }

      c.restore();
    }

    // Update & draw the stag. Geometry unchanged, shades now come from PAL.
    function updateAndDrawDeer(c: CanvasRenderingContext2D, groundY: number) {
      deer.stateTimer--;
      deer.earFlick *= 0.9;
      deer.tailFlick *= 0.9;

      const mouthOffset = 15.5 * DEER_SCALE;
      const distToPointer = pointer.active
        ? Math.hypot(pointer.x - deer.x, pointer.y - (groundY - 26))
        : 999;

      if (deer.state === "grazing") {
        deer.speed = 0;
        deer.neckProgress += (1 - deer.neckProgress) * 0.08;
        deer.chewPhase += 0.18;

        const mouthX = deer.x + deer.dir * mouthOffset;
        if (Math.sin(deer.chewPhase) > 0.5) {
          for (const g of grass) {
            if (Math.abs(g.x - mouthX) < 5) {
              g.vAngle += (Math.random() - 0.5) * 0.28;
            }
          }
        }

        if (Math.random() < 0.015) deer.earFlick = 1;
        if (Math.random() < 0.02) deer.tailFlick = 1;

        if (distToPointer < 30) {
          deer.state = "alert";
          deer.stateTimer = 75;
          deer.earFlick = 1;
        } else if (deer.stateTimer <= 0) {
          deer.targetX = 45 + Math.random() * (cols - 90);
          deer.dir = deer.targetX >= deer.x ? 1 : -1;
          deer.state = "walking";
          deer.stateTimer = 260;
        }
      } else if (deer.state === "alert") {
        deer.speed = 0;
        deer.neckProgress += (0 - deer.neckProgress) * 0.12;
        if (pointer.active) {
          deer.dir = pointer.x >= deer.x ? 1 : -1;
        }
        if (distToPointer >= 34 && deer.stateTimer <= 0) {
          deer.state = "grazing";
          deer.stateTimer = 150 + Math.random() * 120;
        }
      } else if (deer.state === "walking" || deer.state === "trotting") {
        const isTrot = deer.state === "trotting";
        const moveSpd = isTrot ? 0.62 : 0.26;
        deer.speed = moveSpd;
        deer.neckProgress += (0.05 - deer.neckProgress) * 0.12;
        deer.walkCycle += isTrot ? 0.24 : 0.13;

        const dx = deer.targetX - deer.x;
        if (Math.abs(dx) < 3.5) {
          deer.state = "grazing";
          deer.stateTimer = 170 + Math.random() * 140;
          deer.tailFlick = 1;
          treats = treats.filter((tr) => Math.abs(tr.x - (deer.x + deer.dir * mouthOffset)) > 18);
        } else {
          deer.dir = dx >= 0 ? 1 : -1;
          deer.x += deer.dir * moveSpd;
        }

        for (const g of grass) {
          if (Math.abs(g.x - deer.x) < 11) {
            g.vAngle += deer.dir * 0.06;
          }
        }
      }

      c.save();
      const bodyBounce = deer.speed > 0 ? Math.abs(Math.sin(deer.walkCycle)) * 1.8 : 0;
      c.translate(deer.x, groundY - bodyBounce);
      c.scale(deer.dir * DEER_SCALE, DEER_SCALE);

      // 1. Light halo around the stag so it separates from the trees behind it
      c.globalCompositeOperation = "destination-out";
      const halo = c.createRadialGradient(2, -15, 6, 2, -15, 24);
      halo.addColorStop(0, "rgba(0, 0, 0, 0.85)");
      halo.addColorStop(0.7, "rgba(0, 0, 0, 0.45)");
      halo.addColorStop(1, "rgba(0, 0, 0, 0)");
      c.fillStyle = halo;
      c.beginPath();
      c.ellipse(3, -15, 25, 22, 0, 0, Math.PI * 2);
      c.fill();
      c.globalCompositeOperation = "source-over";

      // 2. Legs (far legs are lighter, near legs dark)
      function drawHindLeg(hipX: number, hipY: number, phaseOffset: number, isNear: boolean) {
        const swing = deer.speed > 0 ? Math.sin(deer.walkCycle + phaseOffset) : 0;
        const lift = deer.speed > 0 ? Math.max(0, Math.cos(deer.walkCycle + phaseOffset)) * 3.2 : 0;

        const hockX = hipX - 2.2 + swing * 2.2;
        const hockY = hipY + 6.2 - lift * 0.45;
        const fetlockX = hipX - 1.2 + swing * 4.2;
        const hoofY = -lift;

        c.strokeStyle = grey(isNear ? PAL.deerLegNear : PAL.deerLegFar, 0.98);
        c.lineCap = "round";
        c.lineJoin = "round";

        c.lineWidth = isNear ? 2.4 : 1.9;
        c.beginPath();
        c.moveTo(hipX, hipY);
        c.lineTo(hockX, hockY);
        c.stroke();

        c.lineWidth = isNear ? 1.35 : 1.15;
        c.beginPath();
        c.moveTo(hockX, hockY);
        c.lineTo(fetlockX, hoofY);
        c.stroke();

        c.fillStyle = grey(PAL.deerHoof);
        c.beginPath();
        c.moveTo(fetlockX - 0.8, hoofY);
        c.lineTo(fetlockX + 1.4, hoofY);
        c.lineTo(fetlockX + 0.5, hoofY - 1.3);
        c.closePath();
        c.fill();
      }

      function drawForeLeg(shoulderX: number, shoulderY: number, phaseOffset: number, isNear: boolean) {
        const swing = deer.speed > 0 ? Math.sin(deer.walkCycle + phaseOffset) : 0;
        const lift = deer.speed > 0 ? Math.max(0, Math.cos(deer.walkCycle + phaseOffset)) * 3.2 : 0;

        const kneeX = shoulderX + 0.4 + swing * 2.5 + (lift > 0.5 ? 1.2 : 0);
        const kneeY = shoulderY + 5.8 - lift * 0.5;
        const hoofX = shoulderX + 0.2 + swing * 4.6;
        const hoofY = -lift;

        c.strokeStyle = grey(isNear ? PAL.deerLegNear : PAL.deerLegFar, 0.98);
        c.lineCap = "round";

        c.lineWidth = isNear ? 2.1 : 1.75;
        c.beginPath();
        c.moveTo(shoulderX, shoulderY);
        c.lineTo(kneeX, kneeY);
        c.stroke();

        c.lineWidth = isNear ? 1.3 : 1.1;
        c.beginPath();
        c.moveTo(kneeX, kneeY);
        c.lineTo(hoofX, hoofY);
        c.stroke();

        c.fillStyle = grey(PAL.deerHoof);
        c.beginPath();
        c.moveTo(hoofX - 0.8, hoofY);
        c.lineTo(hoofX + 1.4, hoofY);
        c.lineTo(hoofX + 0.5, hoofY - 1.3);
        c.closePath();
        c.fill();
      }

      drawHindLeg(-7.2, -11.2, Math.PI, false);
      drawForeLeg(6.0, -11.0, 0, false);

      // 3. Torso
      c.fillStyle = grey(PAL.deerBody, 0.98);
      c.beginPath();
      c.moveTo(-9.8, -12.5);
      c.bezierCurveTo(-8.5, -16.2, -4.5, -16.0, -1.0, -15.4);
      c.bezierCurveTo(2.5, -15.0, 5.2, -16.8, 7.6, -15.8);
      c.bezierCurveTo(10.2, -14.2, 10.4, -10.2, 8.2, -8.8);
      c.bezierCurveTo(4.5, -8.2, 0.5, -8.8, -3.5, -9.8);
      c.bezierCurveTo(-6.2, -10.5, -8.5, -10.2, -9.8, -12.5);
      c.closePath();
      c.fill();

      // Lighter belly
      c.fillStyle = grey(PAL.deerBelly, 0.95);
      c.beginPath();
      c.moveTo(-4.0, -9.8);
      c.quadraticCurveTo(2.0, -8.5, 7.8, -9.0);
      c.quadraticCurveTo(4.0, -10.3, -4.0, -9.8);
      c.closePath();
      c.fill();

      // Pale rump patch
      c.fillStyle = grey(PAL.deerRump, 0.9);
      c.beginPath();
      c.ellipse(-8.9, -13.0, 1.3, 2.0, 0.2, 0, Math.PI * 2);
      c.fill();

      // Dappled spots
      c.globalCompositeOperation = "destination-out";
      c.fillStyle = "rgba(0, 0, 0, 0.88)";
      const spots = [
        [-6.2, -14.0],
        [-3.4, -14.5],
        [-0.4, -14.0],
        [2.6, -14.4],
        [-4.8, -12.5],
        [-1.8, -12.6],
        [1.2, -12.8]
      ];
      for (const [sx, sy] of spots) {
        c.beginPath();
        c.arc(sx, sy, 0.68, 0, Math.PI * 2);
        c.fill();
      }
      c.globalCompositeOperation = "source-over";

      drawHindLeg(-7.8, -11.0, 0, true);
      drawForeLeg(6.8, -10.8, Math.PI, true);

      // 4. Tail
      const tailFlickY = Math.sin(time * 8) * deer.tailFlick * 1.8;
      c.strokeStyle = grey(PAL.deerTail, 0.98);
      c.lineWidth = 1.8;
      c.beginPath();
      c.moveTo(-9.4, -14.0);
      c.quadraticCurveTo(-11.5, -13.5 + tailFlickY * 0.5, -12.4, -11.8 + tailFlickY);
      c.stroke();

      // 5. Neck, head, ears & antlers
      const grazeNib = deer.state === "grazing" ? Math.sin(deer.chewPhase) * 0.75 : 0;
      const p = deer.neckProgress;
      const headX = 10.2 + p * 5.8;
      const headY = -24.2 + p * 20.6 + grazeNib;

      c.fillStyle = grey(PAL.deerNeck, 0.98);
      c.beginPath();
      c.moveTo(6.0, -15.5);
      c.quadraticCurveTo(7.8 + p * 3.0, -20.5 + p * 9.5, headX - 1.2, headY - 1.2);
      c.lineTo(headX + 1.0, headY + 1.4);
      c.quadraticCurveTo(10.8 + p * 2.2, -17.5 + p * 10.5, 8.6, -10.5);
      c.closePath();
      c.fill();

      const headAngle = -0.08 + p * 0.95;
      c.save();
      c.translate(headX, headY);
      c.rotate(headAngle);

      const earWiggle = Math.sin(time * 12) * deer.earFlick * 0.25;
      c.fillStyle = grey(PAL.deerEarBack, 0.96);
      c.beginPath();
      c.moveTo(-0.5, -1.2);
      c.quadraticCurveTo(-2.2, -5.2, -0.2, -6.0);
      c.quadraticCurveTo(0.8, -4.0, 0.2, -1.2);
      c.closePath();
      c.fill();

      c.save();
      c.rotate(earWiggle);
      c.fillStyle = grey(PAL.deerEarFront, 0.98);
      c.beginPath();
      c.moveTo(-0.8, -0.8);
      c.quadraticCurveTo(-4.2, -3.8, -3.4, -5.6);
      c.quadraticCurveTo(-1.2, -4.4, -0.2, -1.2);
      c.closePath();
      c.fill();
      c.restore();

      const chewJaw = deer.state === "grazing" ? Math.max(0, Math.sin(deer.chewPhase * 2)) * 0.45 : 0;
      c.fillStyle = grey(PAL.deerHead, 0.98);
      c.beginPath();
      c.moveTo(-1.6, -1.0);
      c.quadraticCurveTo(0.5, -2.4, 2.4, -1.5);
      c.lineTo(6.4, -0.2);
      c.quadraticCurveTo(7.0, 0.5, 6.2, 1.3);
      c.lineTo(2.2, 1.7 + chewJaw);
      c.quadraticCurveTo(0.0, 2.1, -1.4, 0.8);
      c.closePath();
      c.fill();

      c.globalCompositeOperation = "destination-out";
      c.fillStyle = "rgba(0, 0, 0, 0.95)";
      c.beginPath();
      c.arc(1.5, -0.5, 0.65, 0, Math.PI * 2);
      c.fill();
      c.globalCompositeOperation = "source-over";

      // Far antler (lighter)
      c.lineCap = "round";
      c.lineJoin = "round";
      c.strokeStyle = grey(PAL.deerAntlerFar, 0.95);
      c.lineWidth = 1.05;
      c.beginPath();
      c.moveTo(0.6, -1.8);
      c.bezierCurveTo(-1.5, -6.5, 0.5, -10.5, 3.2, -13.2);
      c.moveTo(0.1, -4.5);
      c.lineTo(2.8, -6.2);
      c.moveTo(0.6, -8.5);
      c.lineTo(-1.5, -11.5);
      c.stroke();

      // Near antler (dark)
      c.strokeStyle = grey(PAL.deerAntlerNear, 1);
      c.lineWidth = 1.35;
      c.beginPath();
      c.moveTo(0.2, -1.6);
      c.bezierCurveTo(-2.8, -6.2, -1.0, -10.8, 1.8, -13.8);
      c.stroke();

      c.lineWidth = 1.1;
      c.beginPath();
      c.moveTo(-0.6, -3.4);
      c.quadraticCurveTo(1.8, -4.2, 3.2, -5.8);
      c.moveTo(-1.3, -6.6);
      c.quadraticCurveTo(0.8, -7.8, 2.0, -9.6);
      c.moveTo(-0.5, -9.8);
      c.lineTo(-2.8, -12.6);
      c.moveTo(0.5, -11.6);
      c.lineTo(-0.6, -14.2);
      c.stroke();

      c.restore();
      c.restore();
    }

    function renderLoop() {
      // Stop the loop if Astro swapped this footer out of the DOM
      if (!wrapper.isConnected) {
        ro.disconnect();
        return;
      }

      time += 0.025;

      offCtx.clearRect(0, 0, cols, rows);

      const groundY = rows - 4;
      const ambientWind = 0.22 + Math.sin(time * 0.9) * 0.18;

      // 1. Far background pine treeline
      for (const bp of backPines) {
        const targetSway = Math.sin(time * 1.2 + bp.x * 0.04) * 0.35 + ambientWind * 0.6;
        bp.vSway += (targetSway - bp.sway) * 0.05;
        bp.vSway *= 0.88;
        bp.sway += bp.vSway;
        drawBackPine(offCtx, bp, groundY);
      }

      // 2. Foreground trees: firs and leafless trees
      for (const t of frontTrees) {
        const targetSway = Math.sin(time * 1.4 + t.x * 0.05) * 0.5 + ambientWind;
        t.vSway += (targetSway - t.sway) * 0.06;
        t.vSway *= 0.88;
        t.sway += t.vSway;
        if (t.kind === "fir") drawFir(offCtx, t, groundY);
        else drawBareTree(offCtx, t, groundY);
      }

      // 3. Startled birds
      for (const b of birds) {
        if (b.flying) {
          b.wingPhase += 0.28;
          b.x += b.vx;
          b.y += b.vy;
          b.vy -= 0.004;

          const flap = Math.sin(b.wingPhase) * 3.2;
          offCtx.strokeStyle = grey(PAL.bird, 0.98);
          offCtx.lineWidth = 1.4;
          offCtx.beginPath();
          offCtx.moveTo(b.x - 3.6, b.y - flap);
          offCtx.lineTo(b.x, b.y);
          offCtx.lineTo(b.x + 3.6, b.y - flap);
          offCtx.stroke();

          if (b.y < -8 || b.x < -10 || b.x > cols + 10) {
            const t = frontTrees[b.treeIdx];
            b.flying = false;
            b.x = t.x + t.perch.ox;
            b.y = groundY + t.perch.oy;
          }
        }
      }

      // 4. Back-layer grass (light) & plants
      for (const g of grass) {
        const target = Math.sin(time * 2.2 + g.x * 0.07 + g.phase) * 0.22 + ambientWind * 0.4;
        g.vAngle += (target - g.angle) * g.stiff;
        g.vAngle *= 0.86;
        g.angle += g.vAngle;

        if (g.layer === "back") {
          offCtx.strokeStyle = grey(g.shade, 0.72);
          offCtx.lineWidth = 0.95;
          offCtx.beginPath();
          offCtx.moveTo(g.x, groundY + 1);
          offCtx.quadraticCurveTo(
            g.x + Math.sin(g.angle) * g.h * 0.4,
            groundY - g.h * 0.5,
            g.x + Math.sin(g.angle) * g.h,
            groundY - Math.cos(g.angle) * g.h
          );
          offCtx.stroke();
        }
      }

      for (const p of plants) {
        const target = Math.sin(time * 1.8 + p.x * 0.08) * 0.15 + ambientWind * 0.25;
        p.vBend += (target - p.bend) * 0.08;
        p.vBend *= 0.86;
        p.bend += p.vBend;
        drawPlant(offCtx, p, groundY);
      }

      // User-clicked sprouts
      for (const tr of treats) {
        tr.growth = Math.min(1, tr.growth + 0.06);
        const h = 14 * tr.growth;
        offCtx.strokeStyle = grey(PAL.sprout, 0.96);
        offCtx.lineWidth = 1.4;
        offCtx.beginPath();
        offCtx.moveTo(tr.x, groundY);
        offCtx.lineTo(tr.x, groundY - h);
        offCtx.stroke();
        offCtx.fillStyle = grey(PAL.sproutLeaf, 0.98);
        offCtx.beginPath();
        offCtx.arc(tr.x - 2.8, groundY - h, 2.4, 0, Math.PI * 2);
        offCtx.arc(tr.x + 2.8, groundY - h, 2.4, 0, Math.PI * 2);
        offCtx.arc(tr.x, groundY - h - 3.0, 2.4, 0, Math.PI * 2);
        offCtx.fill();
      }

      // 5. Stag
      updateAndDrawDeer(offCtx, groundY);

      // 6. Ground strip + front grass (dark to mid grey)
      const ground = offCtx.createLinearGradient(0, groundY, 0, rows);
      ground.addColorStop(0, grey(PAL.groundTop, 0.94));
      ground.addColorStop(1, grey(PAL.groundBottom, 0.96));
      offCtx.fillStyle = ground;
      offCtx.fillRect(0, groundY, cols, rows - groundY);

      for (const g of grass) {
        if (g.layer !== "front") continue;
        offCtx.strokeStyle = grey(g.shade, 0.96);
        offCtx.lineWidth = 1.1;
        offCtx.beginPath();
        offCtx.moveTo(g.x, groundY + 2);
        offCtx.quadraticCurveTo(
          g.x + Math.sin(g.angle) * g.h * 0.45,
          groundY - g.h * 0.55,
          g.x + Math.sin(g.angle) * g.h,
          groundY - Math.cos(g.angle) * g.h
        );
        offCtx.stroke();
      }

      // 7. Floating spores
      for (let i = spores.length - 1; i >= 0; i--) {
        const s = spores[i];
        s.x += s.vx + ambientWind * 0.25;
        s.y += s.vy + Math.sin(time * 3 + i) * 0.08;
        s.life++;
        const alpha = Math.max(0, 1 - s.life / s.maxLife);
        offCtx.fillStyle = grey(s.shade, alpha * 0.95);
        offCtx.fillRect(s.x, s.y, 1.6, 1.6);
        if (s.life >= s.maxLife) spores.splice(i, 1);
      }

      // 7.5. Click ripples and sparkles
      for (let i = ripples.length - 1; i >= 0; i--) {
        const rp = ripples[i];
        rp.r += 0.65;
        rp.alpha *= 0.92;
        offCtx.strokeStyle = `rgba(${rp.shade}, ${rp.shade}, ${rp.shade}, ${rp.alpha})`;
        offCtx.lineWidth = 1.2;
        offCtx.beginPath();
        offCtx.arc(rp.x, rp.y, rp.r, 0, Math.PI * 2);
        offCtx.stroke();
        if (rp.alpha < 0.05) ripples.splice(i, 1);
      }

      for (let i = sparkles.length - 1; i >= 0; i--) {
        const sp = sparkles[i];
        sp.x += sp.vx;
        sp.y += sp.vy;
        sp.vx *= 0.94;
        sp.vy *= 0.94;
        sp.life++;
        const prog = sp.life / sp.maxLife;
        const alpha = Math.sin(prog * Math.PI) * 0.95;
        const s = sp.size * (1 - prog * 0.35);

        offCtx.strokeStyle = `rgba(${sp.shade}, ${sp.shade}, ${sp.shade}, ${alpha})`;
        offCtx.lineWidth = 0.9;
        offCtx.beginPath();
        offCtx.moveTo(sp.x - s, sp.y);
        offCtx.lineTo(sp.x + s, sp.y);
        offCtx.moveTo(sp.x, sp.y - s);
        offCtx.lineTo(sp.x, sp.y + s);
        offCtx.stroke();

        if (sp.life >= sp.maxLife) sparkles.splice(i, 1);
      }

      // 8. Shade-aware Bayer dither pass onto the main canvas
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const data = offCtx.getImageData(0, 0, cols, rows).data;
      const dotSize = CELL - 1;

      for (let r = 0; r < rows; r++) {
        const bayerRow = BAYER_8X8[r & 7];
        const rowOffset = r * cols * 4;
        const py = r * CELL;

        for (let c = 0; c < cols; c++) {
          const idx = rowOffset + c * 4;
          const alpha = data[idx + 3];
          if (alpha <= 12) continue;

          const threshold = bayerRow[c & 7] * 4;
          if (alpha > threshold) {
            const shade = data[idx];
            ctx.fillStyle = SHADE_LUT[shade];
            ctx.fillRect(c * CELL, py, dotSize, dotSize);
          }
        }
      }

      if (!isVisible || document.hidden) {
        rafId = null;
        return;
      }
      rafId = requestAnimationFrame(renderLoop);
    }

    let isVisible = false;
    let rafId: number | null = null;

    function startLoop() {
      if (rafId === null && isVisible && !document.hidden) {
        rafId = requestAnimationFrame(renderLoop);
      }
    }

    function stopLoop() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        isVisible = entry?.isIntersecting ?? false;
        if (isVisible) {
          startLoop();
        } else {
          stopLoop();
        }
      },
      { threshold: 0 }
    );
    observer.observe(wrapper);

    const onVisibilityChange = () => {
      if (document.hidden) {
        stopLoop();
      } else if (isVisible) {
        startLoop();
      }
    };
    document.addEventListener("visibilitychange", onVisibilityChange);
  }

  function bootForestFooters() {
    document.querySelectorAll<HTMLElement>(".forest-footer-art").forEach(initForestFooter);
  }

  bootForestFooters();
  document.addEventListener("astro:page-load", bootForestFooters);
</script>