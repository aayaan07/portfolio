---
// Footer
const initialTime = new Intl.DateTimeFormat('en-US', {
  timeZone: 'Asia/Kolkata',
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
}).format(new Date()) + ' IST';
---

<footer class="w-full max-w-[760px] mx-auto px-[1.25rem] md:px-[2rem] py-[4rem]">
  <div class="pt-[2.5rem] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-[1.5rem] border-t border-neutral-200/80">
    <div class="flex flex-col gap-[0.25rem]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-[13px] leading-[18px] tracking-[0.01em] font-medium text-text-primary">Gurugram, India</span>
        <span class="text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-muted">
          · <span id="gurugram-time">{initialTime}</span>
        </span>
      </div>
      <p class="text-[13px] leading-[20px] text-text-muted">© 2026 Aayaan Kumar. Crafted with restraint.</p>
    </div>

    <div class="flex items-center gap-1 text-[12px] sm:text-[13px] leading-[20px] text-text-muted">
      <span>Icons by</span>
      <a
        href="https://icons8.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-primary hover:text-black font-medium underline underline-offset-2 transition-colors"
      >Icons8</a>
    </div>
  </div>
</footer>

<script>
  let timeIntervalId: number | undefined;

  function updateGurugramTime() {
    const timeEl = document.getElementById('gurugram-time');
    if (!timeEl) return;
    try {
      const now = new Date();
      const timeString = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Kolkata',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
      }).format(now);
      timeEl.textContent = `${timeString} IST`;
    } catch {
      // Keep existing SSR text on error
    }
  }

  function startGurugramClock() {
    if (timeIntervalId) {
      window.clearInterval(timeIntervalId);
    }
    updateGurugramTime();
    timeIntervalId = window.setInterval(updateGurugramTime, 1000);
  }

  startGurugramClock();
  document.addEventListener('astro:page-load', startGurugramClock);
  document.addEventListener('astro:before-swap', () => {
    if (timeIntervalId) {
      window.clearInterval(timeIntervalId);
      timeIntervalId = undefined;
    }
  });
</script>
