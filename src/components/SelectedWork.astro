---
// Selected Work / Portfolio Section
---

<section id="projects" class="py-[2.5rem] flex flex-col gap-[1.5rem] scroll-mt-6" data-gsap="work">
  <div class="flex items-end justify-between">
    <div class="flex flex-col">
      <span class="text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-muted uppercase">Portfolio</span>
      <h2 class="text-[24px] leading-[32px] tracking-[-0.02em] font-semibold text-text-primary">Selected Work</h2>
    </div>
  </div>

  <!-- Project 1: Kaptions -->
  <div class="work-card group flex flex-col gap-[0.5rem] pb-[1.5rem]">
    <a href="https://kaptions.pages.dev/" target="_blank" rel="noopener noreferrer" class="relative w-full aspect-[16/9] bg-[#eeeeee] overflow-hidden rounded-xl border border-neutral-200/70 shadow-[0_2px_8px_rgba(0,0,0,0.04)] block">
      <img
        class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-300"
        alt="Kaptions client-side video captioning platform"
        src="/p1.webp"
        width="760"
        height="428"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute top-4 left-4 flex gap-1.5">
        <span class="px-2.5 py-1 rounded-full bg-white/95 backdrop-blur-sm text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-primary tactile-pill border border-neutral-200/80">AI Tool</span>
      </div>
    </a>
    <div class="flex flex-col justify-between py-2">
      <div class="flex items-baseline justify-between gap-2">
        <a href="https://kaptions.pages.dev/" target="_blank" rel="noopener noreferrer" class="text-[18px] leading-[26px] tracking-[-0.015em] font-semibold text-text-primary group-hover:text-black hover:underline transition-colors">
          Kaptions — Client-Side Video Captioning
        </a>
        <a href="https://kaptions.pages.dev/" target="_blank" rel="noopener noreferrer" class="text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-muted hover:text-text-primary flex items-center gap-1 flex-shrink-0 transition-colors">
          <span>kaptions.pages.dev</span>
          <span class="material-symbols-outlined text-[14px]">open_in_new</span>
        </a>
      </div>
      <p class="text-[15px] leading-[24px] tracking-[-0.005em] text-on-surface-variant">
        Built a client-side captioning platform that transcribes and burns styled captions in videos, no server or upload needed.
      </p>
      <div class="flex flex-wrap items-center gap-2 pt-[0.25rem]">
        <span class="px-2.5 py-1 rounded-md bg-surface-subtle text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-on-surface-variant tactile-tag border border-neutral-200/60">HTML/CSS</span>
        <span class="px-2.5 py-1 rounded-md bg-surface-subtle text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-on-surface-variant tactile-tag border border-neutral-200/60">JavaScript</span>
        <span class="px-2.5 py-1 rounded-md bg-surface-subtle text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-on-surface-variant tactile-tag border border-neutral-200/60">Gemini API</span>
      </div>
    </div>
  </div>

  <!-- Project 2: GamersDex -->
  <div class="work-card group flex flex-col gap-[0.5rem] pb-[1.5rem]">
    <a href="https://gamersdex.vercel.app/" target="_blank" rel="noopener noreferrer" class="relative w-full aspect-[16/9] bg-[#eeeeee] overflow-hidden rounded-xl border border-neutral-200/70 shadow-[0_2px_8px_rgba(0,0,0,0.04)] block">
      <img
        class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-300"
        alt="GamersDex gaming profile platform"
        src="/p2.webp"
        width="760"
        height="428"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute top-4 left-4 flex gap-1.5">
        <span class="px-2.5 py-1 rounded-full bg-white/95 backdrop-blur-sm text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-primary tactile-pill border border-neutral-200/80">Platform</span>
      </div>
    </a>
    <div class="flex flex-col justify-between py-2">
      <div class="flex items-baseline justify-between gap-2">
        <a href="https://gamersdex.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-[18px] leading-[26px] tracking-[-0.015em] font-semibold text-text-primary group-hover:text-black hover:underline transition-colors">
          GamersDex — Gaming Profile Platform
        </a>
        <a href="https://gamersdex.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-muted hover:text-text-primary flex items-center gap-1 flex-shrink-0 transition-colors">
          <span>gamersdex.vercel.app</span>
          <span class="material-symbols-outlined text-[14px]">open_in_new</span>
        </a>
      </div>
      <p class="text-[15px] leading-[24px] tracking-[-0.005em] text-on-surface-variant">
        Built a gaming profile platform to track completed, active, wishlisted, and dropped games via shareable profile URLs.
      </p>
      <div class="flex flex-wrap items-center gap-2 pt-[0.25rem]">
        <span class="px-2.5 py-1 rounded-md bg-surface-subtle text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-on-surface-variant tactile-tag border border-neutral-200/60">Next.js</span>
        <span class="px-2.5 py-1 rounded-md bg-surface-subtle text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-on-surface-variant tactile-tag border border-neutral-200/60">Firebase</span>
        <span class="px-2.5 py-1 rounded-md bg-surface-subtle text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-on-surface-variant tactile-tag border border-neutral-200/60">Tailwind CSS</span>
        <span class="px-2.5 py-1 rounded-md bg-surface-subtle text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-on-surface-variant tactile-tag border border-neutral-200/60">RAWG API</span>
      </div>
    </div>
  </div>

