---
// Spotify Current Rotation Section
const playlist = [
  'https://open.spotify.com/embed/track/3en2lZzcpnsHSFFWDErrll?utm_source=generator&si=c5b587cd6d3c4c06&theme=0',
  'https://open.spotify.com/embed/track/0VjIjW4GlUZAMYd2vXMi3b?utm_source=generator&si=14084024fcf84ced&theme=0',
  'https://open.spotify.com/embed/track/7MXVkk9YMctZqd1Srtv4MB?utm_source=generator&si=7396195551514cfd&theme=0',
  'https://open.spotify.com/embed/track/5M7HgXGzRMi2KJ6w3tmfob?utm_source=generator&si=7d4b1d42422b4a00&theme=0',
  'https://open.spotify.com/embed/track/3snOK8WsuftpvpDKGKhxfZ?utm_source=generator&si=1a818ea45c104977&theme=0',
  'https://open.spotify.com/embed/track/7fyiYhn7STpHvT5g0lbncC?utm_source=generator&si=843b98c0291d4051&theme=0',
  'https://open.spotify.com/embed/track/4AoQVhME8Ko6LNm4lV2wwQ?utm_source=generator&si=e6571a456ad74a95&theme=0',
];

const initialTrack = playlist[Math.floor(Math.random() * playlist.length)];
---

<section class="py-[2.5rem] flex flex-col gap-[1.5rem]" data-gsap="spotify">
  <div class="flex items-end justify-between">
    <div class="flex flex-col">
      <span class="text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-muted uppercase">Now Playing</span>
      <h2 class="text-[24px] leading-[32px] tracking-[-0.02em] font-semibold text-text-primary">Current Rotation</h2>
    </div>
    <button
      id="shuffle-track-btn"
      class="text-[12px] leading-[18px] tracking-[0.01em] font-medium text-text-muted hover:text-text-primary flex items-center gap-1.5 transition-colors tactile-btn px-3 py-1.5 rounded-full border border-neutral-200/70 bg-surface shadow-[0_2px_0_#e5e7eb] cursor-pointer"
      title="Randomize track"
    >
      <span class="material-symbols-outlined text-[15px] transition-transform" id="shuffle-icon">shuffle</span>
      <span>Shuffle Track</span>
    </button>
  </div>

  <iframe
    id="spotify-iframe"
    title="Spotify Track Player"
    data-testid="embed-iframe"
    class="border-0 rounded-xl"
    src={initialTrack}
    width="100%"
    height="250"
    allowfullscreen=""
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"
  ></iframe>
</section>

<script>
  const playlist: string[] = [
    'https://open.spotify.com/embed/track/3en2lZzcpnsHSFFWDErrll?utm_source=generator&si=c5b587cd6d3c4c06&theme=0',
    'https://open.spotify.com/embed/track/0VjIjW4GlUZAMYd2vXMi3b?utm_source=generator&si=14084024fcf84ced&theme=0',
    'https://open.spotify.com/embed/track/7MXVkk9YMctZqd1Srtv4MB?utm_source=generator&si=7396195551514cfd&theme=0',
    'https://open.spotify.com/embed/track/5M7HgXGzRMi2KJ6w3tmfob?utm_source=generator&si=7d4b1d42422b4a00&theme=0',
    'https://open.spotify.com/embed/track/3snOK8WsuftpvpDKGKhxfZ?utm_source=generator&si=1a818ea45c104977&theme=0',
    'https://open.spotify.com/embed/track/7fyiYhn7STpHvT5g0lbncC?utm_source=generator&si=843b98c0291d4051&theme=0',
    'https://open.spotify.com/embed/track/4AoQVhME8Ko6LNm4lV2wwQ?utm_source=generator&si=e6571a456ad74a95&theme=0',
  ];

  function setupSpotifyShuffle() {
    const iframe = document.getElementById('spotify-iframe') as HTMLIFrameElement | null;
    const shuffleBtn = document.getElementById('shuffle-track-btn');
    const shuffleIcon = document.getElementById('shuffle-icon');

    function pickRandomTrack() {
      if (!iframe || playlist.length <= 1) return;
      const currentSrc = iframe.src;
      const pool = playlist.filter(url => url !== currentSrc);
      const chosen = pool.length > 0 ? pool[Math.floor(Math.random() * pool.length)] : playlist[0];
      iframe.src = chosen;
    }

    if (shuffleBtn && !shuffleBtn.dataset.bound) {
      shuffleBtn.dataset.bound = 'true';
      shuffleBtn.addEventListener('click', () => {
        if (shuffleIcon) {
          shuffleIcon.classList.add('rotate-180');
          setTimeout(() => shuffleIcon.classList.remove('rotate-180'), 300);
        }
        pickRandomTrack();
      });
    }
  }

  setupSpotifyShuffle();
  document.addEventListener('astro:page-load', setupSpotifyShuffle);
</script>
