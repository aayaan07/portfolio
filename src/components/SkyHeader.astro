---
// src/components/SkyHeader.astro
interface Props {
  height?: string;
  dotSize?: number;
}

const { height = "210px", dotSize = 3 } = Astro.props;
---

<div
  class="sky-header-art"
  style={`--sky-height: ${height};`}
  data-dot-size={dotSize}
>
  <canvas
    class="sky-canvas"
    aria-label="Interactive monochrome dotted sky with 1.4x larger clouds, small moon, and birds"
  ></canvas>
</div>

<style>
  .sky-header-art {
    position: relative;
    width: 100%;
    height: var(--sky-height, 210px);
    background: transparent;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    cursor: -webkit-image-set(url('/pointer.png') 1x, url('/pointer@2x.png') 2x) 1 1, url('/pointer.png') 1 1, auto !important;
    cursor: image-set(url('/pointer.png') 1x, url('/pointer@2x.png') 2x) 1 1, url('/pointer.png') 1 1, auto !important;
  }

  .sky-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: -webkit-image-set(url('/pointer.png') 1x, url('/pointer@2x.png') 2x) 1 1, url('/pointer.png') 1 1, auto !important;
    cursor: image-set(url('/pointer.png') 1x, url('/pointer@2x.png') 2x) 1 1, url('/pointer.png') 1 1, auto !important;
  }

  .sky-canvas[style*="cursor: pointer"],
  .sky-canvas[style*="cursor:pointer"],
  .sky-canvas[style*="cursor: grab"],
  .sky-canvas[style*="cursor:grab"],
  .sky-canvas[style*="cursor: grabbing"],
  .sky-canvas[style*="cursor:grabbing"] {
    cursor: -webkit-image-set(url('/hand-pointer.png') 1x, url('/hand-pointer@2x.png') 2x) 6 1, url('/hand-pointer.png') 6 1, pointer !important;
    cursor: image-set(url('/hand-pointer.png') 1x, url('/hand-pointer@2x.png') 2x) 6 1, url('/hand-pointer.png') 6 1, pointer !important;
  }
</style>

<script>
  import { playTapSound } from '../utils/sound';

  const BAYER_8X8 = [
    [ 0, 32,  8, 40,  2, 34, 10, 42],
    [48, 16, 56, 24, 50, 18, 58, 26],
    [12, 44,  4, 36, 14, 46,  6, 38],
    [60, 28, 52, 20, 62, 30, 54, 22],
    [ 3, 35, 11, 43,  1, 33,  9, 41],
    [51, 19, 59, 27, 49, 17, 57, 25],
    [15, 47,  7, 39, 13, 45,  5, 37],
    [63, 31, 55, 23, 61, 29, 53, 21]
  ];

  const SHADE_LUT: string[] = Array.from({ length: 256 }, (_, i) => `rgb(${i},${i},${i})`);

  function initSkyHeader(wrapper: HTMLElement) {
    if (wrapper.dataset.ready === "true") return;
    wrapper.dataset.ready = "true";

    const canvas = wrapper.querySelector(".sky-canvas") as HTMLCanvasElement;
    const ctx = canvas.getContext("2d", { alpha: true })!;

    const offCanvas = document.createElement("canvas");
    const offCtx = offCanvas.getContext("2d", { willReadFrequently: true })!;

    const moonCanvas = document.createElement("canvas");
    const moonCtx = moonCanvas.getContext("2d")!;

    const CELL = Math.max(2, Number(wrapper.dataset.dotSize) || 3);
    let cols = 0;
    let rows = 0;
    let time = 0;

    const pointer = { x: -999, y: -999, vx: 0, vy: 0, active: false };

    // Small Moon
    const moon = {
      x: 0,
      y: 0,
      r: 10.5,
      phase: 0.35, // 0 = full, 0.35 = crescent, 0.58 = thin crescent
      pulse: 0
    };

    interface Cloud {
      x: number;
      y: number;
      rx: number;
      ry: number;
      speed: number;
      shade: number;
      puffs: { ox: number; oy: number; r: number }[];
      dragging: boolean;
    }

    interface Bird {
      x: number;
      y: number;
      vx: number;
      vy: number;
      wingPhase: number;
      wingSpeed: number;
      size: number;
      targetX: number | null;
      targetY: number | null;
    }

    interface Ripple {
      x: number;
      y: number;
      r: number;
      alpha: number;
      shade: number;
    }

    let clouds: Cloud[] = [];
    let birds: Bird[] = [];
    let ripples: Ripple[] = [];
    let draggedCloud: Cloud | null = null;

    function setupSky() {
      moon.x = cols * 0.78;
      moon.y = rows * 0.36;
      moon.r = Math.max(9, Math.min(12, rows * 0.18));

      // 1.4x Larger Clouds (Previously rx: 13..21, ry: 5..7.5 -> Now rx: 18.2..29.4, ry: 7..10.5)
      clouds = [];
      const count = Math.max(5, Math.floor(cols / 62));
      for (let i = 0; i < count; i++) {
        const rx = (13 + Math.random() * 8) * 1.4;
        const ry = (5 + Math.random() * 2.5) * 1.4;
        const puffs = [];
        const puffCount = 6;
        for (let p = 0; p < puffCount; p++) {
          const norm = p / (puffCount - 1) - 0.5;
          puffs.push({
            ox: norm * rx * 1.38,
            oy: (Math.random() - 0.5) * ry * 0.45,
            r: ry * (0.78 + Math.cos(norm * Math.PI) * 0.58)
          });
        }
        clouds.push({
          x: (cols / count) * i + Math.random() * 24,
          y: rows * (0.22 + (i % 3) * 0.19),
          rx,
          ry,
          speed: 0.028 + Math.random() * 0.038,
          shade: i % 2 === 0 ? 116 : 140,
          puffs,
          dragging: false
        });
      }

      // Pitch-Black Birds
      birds = [];
      const birdCount = 11;
      for (let i = 0; i < birdCount; i++) {
        birds.push({
          x: Math.random() * cols,
          y: rows * (0.15 + Math.random() * 0.55),
          vx: 0.22 + Math.random() * 0.18,
          vy: (Math.random() - 0.5) * 0.06,
          wingPhase: Math.random() * Math.PI * 2,
          wingSpeed: 0.18 + Math.random() * 0.06,
          size: 2.9 + (i % 3) * 0.45,
          targetX: null,
          targetY: null
        });
      }
    }

    function resize() {
      const rect = wrapper.getBoundingClientRect();
      const w = Math.max(300, Math.floor(rect.width));
      const h = Math.max(130, Math.floor(rect.height));
      canvas.width = w;
      canvas.height = h;
      cols = Math.floor(w / CELL);
      rows = Math.floor(h / CELL);
      offCanvas.width = cols;
      offCanvas.height = rows;
      moonCanvas.width = cols;
      moonCanvas.height = rows;
      setupSky();
    }

    const ro = new ResizeObserver(resize);
    ro.observe(wrapper);
    resize();

    canvas.addEventListener("pointermove", (e) => {
      const rect = canvas.getBoundingClientRect();
      const cx = (e.clientX - rect.left) / CELL;
      const cy = (e.clientY - rect.top) / CELL;
      pointer.vx = cx - pointer.x;
      pointer.vy = cy - pointer.y;
      pointer.x = cx;
      pointer.y = cy;
      pointer.active = true;

      if (draggedCloud) {
        draggedCloud.x += pointer.vx;
        draggedCloud.y = Math.max(8, Math.min(rows - 10, draggedCloud.y + pointer.vy));
        canvas.style.cursor = "grabbing";
        return;
      }

      const onMoon = Math.hypot(cx - moon.x, cy - moon.y) <= moon.r + 3;
      const onCloud = clouds.some(
        (c) => Math.abs(cx - c.x) < c.rx && Math.abs(cy - c.y) < c.ry * 1.4
      );
      canvas.style.cursor = onCloud ? "grab" : onMoon ? "pointer" : "default";
    });

    canvas.addEventListener("pointerleave", () => {
      pointer.active = false;
      canvas.style.cursor = "default";
    });

    canvas.addEventListener("pointerdown", (e) => {
      const rect = canvas.getBoundingClientRect();
      const cx = (e.clientX - rect.left) / CELL;
      const cy = (e.clientY - rect.top) / CELL;

      // 1. Click Moon -> cycle crescent / full phase
      if (Math.hypot(cx - moon.x, cy - moon.y) <= moon.r + 3) {
        playTapSound(0.5);
        const phases = [0.35, 0, 0.58];
        const curIdx = phases.indexOf(moon.phase);
        moon.phase = phases[(curIdx + 1) % phases.length];
        moon.pulse = 1;
        ripples.push({ x: moon.x, y: moon.y, r: moon.r, alpha: 0.9, shade: 35 });
        return;
      }

      // 2. Grab 1.4x Cloud
      for (const c of clouds) {
        if (Math.abs(cx - c.x) < c.rx && Math.abs(cy - c.y) < c.ry * 1.5) {
          draggedCloud = c;
          c.dragging = true;
          canvas.style.cursor = "grabbing";
          return;
        }
      }

      // 3. Click open sky -> attract birds
      ripples.push({ x: cx, y: cy, r: 2, alpha: 0.75, shade: 80 });
      for (const b of birds) {
        b.targetX = cx + (Math.random() - 0.5) * 28;
        b.targetY = cy + (Math.random() - 0.5) * 14;
      }
    });

    window.addEventListener("pointerup", () => {
      if (draggedCloud) {
        draggedCloud.dragging = false;
        draggedCloud = null;
        canvas.style.cursor = "default";
      }
    });

    function drawBird(c: CanvasRenderingContext2D, b: Bird) {
      const flap = Math.sin(b.wingPhase);
      const s = b.size;
      const dir = b.vx >= 0 ? 1 : -1;

      c.save();
      c.translate(b.x, b.y);
      const pitch = Math.max(-0.4, Math.min(0.4, b.vy * 1.4)) * dir;
      c.rotate(pitch);

      c.strokeStyle = "rgba(8, 8, 10, 0.98)";
      c.lineWidth = 1.3;
      c.lineCap = "round";
      c.lineJoin = "round";

      const midWingY = -flap * s * 0.65;
      const tipWingY = -flap * s * 1.15 + (flap < 0 ? s * 0.25 : 0);

      c.beginPath();
      c.moveTo(-s * 1.25, tipWingY);
      c.quadraticCurveTo(-s * 0.55, midWingY, 0, 0);
      c.quadraticCurveTo(s * 0.55, midWingY, s * 1.25, tipWingY);
      c.stroke();

      c.fillStyle = "rgba(5, 5, 5, 1)";
      c.fillRect(-0.9, -0.7, 1.8, 1.5);
      c.restore();
    }

    function renderLoop() {
      time += 0.025;
      moon.pulse *= 0.92;

      offCtx.clearRect(0, 0, cols, rows);

      // 1. Draw 1.4x Larger Mist-Grey Clouds (Shades 116..140)
      for (const c of clouds) {
        if (!c.dragging) {
          c.x += c.speed;
          if (c.x > cols + c.rx * 1.6) c.x = -c.rx * 1.6;
        }

        const sh = c.shade;
        for (const p of c.puffs) {
          const px = c.x + p.ox;
          const py = c.y + p.oy;
          const g = offCtx.createRadialGradient(px, py - p.r * 0.2, 0.8, px, py, p.r);
          g.addColorStop(0, `rgba(${sh}, ${sh}, ${sh}, 0.68)`);
          g.addColorStop(0.65, `rgba(${sh + 18}, ${sh + 18}, ${sh + 18}, 0.34)`);
          g.addColorStop(1, `rgba(${sh + 25}, ${sh + 25}, ${sh + 25}, 0)`);
          offCtx.fillStyle = g;
          offCtx.beginPath();
          offCtx.arc(px, py, p.r, 0, Math.PI * 2);
          offCtx.fill();
        }
      }

      // 2. Draw Charcoal Moon on Isolated Buffer (Shade 34 + Dark Craters)
      moonCtx.clearRect(0, 0, cols, rows);
      const haloGrad = moonCtx.createRadialGradient(
        moon.x,
        moon.y,
        moon.r * 0.5,
        moon.x,
        moon.y,
        moon.r * (1.85 + moon.pulse * 0.6)
      );
      haloGrad.addColorStop(0, "rgba(130, 130, 138, 0.32)");
      haloGrad.addColorStop(1, "rgba(130, 130, 138, 0)");
      moonCtx.fillStyle = haloGrad;
      moonCtx.beginPath();
      moonCtx.arc(moon.x, moon.y, moon.r * 2.2, 0, Math.PI * 2);
      moonCtx.fill();

      const moonGrad = moonCtx.createRadialGradient(
        moon.x - moon.r * 0.25,
        moon.y - moon.r * 0.25,
        1,
        moon.x,
        moon.y,
        moon.r
      );
      moonGrad.addColorStop(0, "rgba(42, 42, 46, 0.96)");
      moonGrad.addColorStop(0.75, "rgba(28, 28, 32, 0.92)");
      moonGrad.addColorStop(1, "rgba(14, 14, 18, 0.98)");
      moonCtx.fillStyle = moonGrad;
      moonCtx.beginPath();
      moonCtx.arc(moon.x, moon.y, moon.r, 0, Math.PI * 2);
      moonCtx.fill();

      moonCtx.fillStyle = "rgba(8, 8, 10, 0.98)";
      moonCtx.beginPath();
      moonCtx.arc(moon.x - moon.r * 0.25, moon.y - moon.r * 0.15, moon.r * 0.18, 0, Math.PI * 2);
      moonCtx.arc(moon.x + moon.r * 0.15, moon.y + moon.r * 0.28, moon.r * 0.14, 0, Math.PI * 2);
      moonCtx.fill();

      if (moon.phase > 0.05) {
        moonCtx.globalCompositeOperation = "destination-out";
        moonCtx.fillStyle = "rgba(0, 0, 0, 1)";
        moonCtx.beginPath();
        moonCtx.arc(
          moon.x + moon.r * (0.55 - moon.phase * 0.3),
          moon.y - moon.r * 0.12,
          moon.r * 0.88,
          0,
          Math.PI * 2
        );
        moonCtx.fill();
        moonCtx.globalCompositeOperation = "source-over";
      }

      offCtx.drawImage(moonCanvas, 0, 0);

      // 3. Update & Draw Pitch-Black Birds
      for (const b of birds) {
        b.wingPhase += b.wingSpeed;

        if (pointer.active) {
          const dx = b.x - pointer.x;
          const dy = b.y - pointer.y;
          const dist = Math.hypot(dx, dy);
          if (dist < 22 && dist > 0.1) {
            const push = (22 - dist) / 22;
            b.vx += (dx / dist) * push * 0.09;
            b.vy += (dy / dist) * push * 0.09;
            b.wingPhase += 0.14;
          }
        }

        if (b.targetX !== null && b.targetY !== null) {
          const tx = b.targetX - b.x;
          const ty = b.targetY - b.y;
          const tDist = Math.hypot(tx, ty);
          if (tDist < 8) {
            b.targetX = null;
            b.targetY = null;
          } else {
            b.vx += (tx / tDist) * 0.015;
            b.vy += (ty / tDist) * 0.015;
          }
        }

        b.vy += Math.sin(time * 1.5 + b.wingPhase * 0.2) * 0.003;
        if (b.y < 8) b.vy += 0.02;
        if (b.y > rows - 10) b.vy -= 0.02;

        const spd = Math.hypot(b.vx, b.vy);
        if (spd > 0.65) {
          b.vx = (b.vx / spd) * 0.65;
          b.vy = (b.vy / spd) * 0.65;
        } else if (spd < 0.18) {
          b.vx = (b.vx >= 0 ? 1 : -1) * 0.22;
        }

        b.x += b.vx;
        b.y += b.vy;

        if (b.x > cols + 10) b.x = -10;
        if (b.x < -10) b.x = cols + 10;

        drawBird(offCtx, b);
      }

      // 4. Draw Ripples
      for (let i = ripples.length - 1; i >= 0; i--) {
        const rp = ripples[i];
        rp.r += 0.55;
        rp.alpha *= 0.93;
        offCtx.strokeStyle = `rgba(${rp.shade}, ${rp.shade}, ${rp.shade}, ${rp.alpha})`;
        offCtx.lineWidth = 1.1;
        offCtx.beginPath();
        offCtx.arc(rp.x, rp.y, rp.r, 0, Math.PI * 2);
        offCtx.stroke();
        if (rp.alpha < 0.05) ripples.splice(i, 1);
      }

      // 5. Monochrome Shade-Aware Bayer Dither Pass
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const data = offCtx.getImageData(0, 0, cols, rows).data;
      const dotSize = CELL - 1;

      for (let r = 0; r < rows; r++) {
        const bayerRow = BAYER_8X8[r & 7];
        const rowOffset = r * cols * 4;
        const py = r * CELL;

        for (let c = 0; c < cols; c++) {
          const idx = rowOffset + c * 4;
          const alpha = data[idx + 3];
          if (alpha <= 12) continue;

          const threshold = bayerRow[c & 7] * 4;
          if (alpha > threshold) {
            const shade = data[idx];
            ctx.fillStyle = SHADE_LUT[shade];
            ctx.fillRect(c * CELL, py, dotSize, dotSize);
          }
        }
      }

      if (!isVisible || document.hidden) {
        rafId = null;
        return;
      }
      rafId = requestAnimationFrame(renderLoop);
    }

    let isVisible = true;
    let rafId: number | null = null;

    function startLoop() {
      if (rafId === null && isVisible && !document.hidden) {
        rafId = requestAnimationFrame(renderLoop);
      }
    }

    function stopLoop() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        isVisible = entry?.isIntersecting ?? false;
        if (isVisible) {
          startLoop();
        } else {
          stopLoop();
        }
      },
      { threshold: 0 }
    );
    observer.observe(wrapper);

    const onVisibilityChange = () => {
      if (document.hidden) {
        stopLoop();
      } else if (isVisible) {
        startLoop();
      }
    };
    document.addEventListener("visibilitychange", onVisibilityChange);

    startLoop();
  }

  function bootSkyHeaders() {
    document.querySelectorAll<HTMLElement>(".sky-header-art").forEach(initSkyHeader);
  }

  bootSkyHeaders();
  document.addEventListener("astro:page-load", bootSkyHeaders);
</script>