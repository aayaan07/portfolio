<section class="py-[2.5rem] flex flex-col gap-[1.5rem]" data-gsap="snapshots">
  <div class="flex items-end justify-between">
    <div class="flex flex-col">
      <span class="text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-muted uppercase">Photographs & Memories</span>
      <h2 class="text-[24px] leading-[32px] tracking-[-0.02em] font-semibold text-text-primary">Snapshots</h2>
    </div>
  </div>
  <div class="w-full overflow-x-auto pb-6 pt-4 px-3 sm:px-4 -mx-3 sm:-mx-4">
    <div class="flex items-center justify-start sm:justify-center gap-3 sm:gap-4 min-w-max py-2">
      {photos.map(photo => (
        <div
          class="polaroid-card cursor-pointer bg-white p-2.5 pb-4 sm:p-3 sm:pb-5 rounded-[4px] border border-neutral-200/90 w-[150px] sm:w-[165px] flex flex-col items-center hover:!rotate-0"
          style={`rotate: ${photo.rotation}`}
          data-caption={photo.caption}
          data-full={photo.img}
        >
          <div class="w-full aspect-square overflow-hidden bg-neutral-100 rounded-[2px] shadow-inner">
            <img class="w-full h-full object-cover" alt={photo.caption} src={photo.img} />
          </div>
          <span class="font-[Caveat,cursive] text-[22px] sm:text-[24px] text-neutral-900 mt-2 sm:mt-2.5 font-bold tracking-wide select-none">{photo.caption}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox Modal -->
<div aria-modal="true" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300" id="polaroid-modal" role="dialog">
  <div class="relative max-w-[90vw] max-h-[85vh] bg-white p-4 sm:p-5 pb-8 sm:pb-9 rounded shadow-2xl flex flex-col items-center transform scale-95 transition-transform duration-300" id="polaroid-modal-card">
    <button aria-label="Close photo preview" class="absolute -top-3.5 -right-3.5 sm:-top-4 sm:-right-4 w-9 h-9 rounded-full bg-black text-white flex items-center justify-center shadow-lg hover:bg-neutral-800 focus:outline-none" id="polaroid-modal-close">
      <span class="material-symbols-outlined text-[18px]">close</span>
    </button>
    <div class="relative w-auto max-h-[65vh] overflow-hidden rounded-[2px] bg-neutral-900 flex items-center justify-center">
      <img alt="Enlarged photo" class="max-h-[65vh] w-auto max-w-full object-contain" id="polaroid-modal-img" src="" />
    </div>
    <span class="font-[Caveat,cursive] text-[32px] sm:text-[36px] text-neutral-900 font-bold mt-4 tracking-wide select-none" id="polaroid-modal-caption"></span>
  </div>
</div>

<script>
  // Polaroid Lightbox
  const modal = document.getElementById('polaroid-modal');
  const modalCard = document.getElementById('polaroid-modal-card');
  const modalImg = document.getElementById('polaroid-modal-img') as HTMLImageElement;
  const modalCaption = document.getElementById('polaroid-modal-caption');
  const modalClose = document.getElementById('polaroid-modal-close');
  const polaroidCards = document.querySelectorAll('.polaroid-card');

  function openModal(fullSrc: string, caption: string) {
    if (!modal || !modalImg || !modalCaption) return;
    modalImg.src = fullSrc;
    modalCaption.textContent = caption;
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modalCard?.classList.remove('scale-95');
    modalCard?.classList.add('scale-100');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('opacity-0', 'pointer-events-none');
    modalCard?.classList.remove('scale-100');
    modalCard?.classList.add('scale-95');
    document.body.style.overflow = '';
    setTimeout(() => {
      if (modalImg) modalImg.src = '';
    }, 300);
  }

  polaroidCards.forEach(card => {
    card.addEventListener('click', () => {
      const fullSrc = card.getAttribute('data-full');
      const caption = card.getAttribute('data-caption') || '';
      if (fullSrc) openModal(fullSrc, caption);
    });
  });

  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('opacity-0')) {
      closeModal();
    }
  });
</script>
