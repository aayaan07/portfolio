---
// Snapshots Section - 3-Column Masonry Gallery with Randomized Photos & Progressive 2-Row Reveal
const shots = [
  { src: '/shots/img-1.webp', alt: 'Snapshot 1' },
  { src: '/shots/IMG_20260208_152037.webp', alt: 'Snapshot 2' },
  { src: '/shots/IMG_20260208_152238.webp', alt: 'Snapshot 3' },
  { src: '/shots/IMG_20260208_152402.webp', alt: 'Snapshot 4' },
  { src: '/shots/IMG_20260308_102313.webp', alt: 'Snapshot 5' },
  { src: '/shots/IMG_20260308_102350.webp', alt: 'Snapshot 6' },
  { src: '/shots/IMG_20260308_102353.webp', alt: 'Snapshot 7' },
  { src: '/shots/IMG_20260314_182116.webp', alt: 'Snapshot 8' },
  { src: '/shots/IMG_20260530_155317.webp', alt: 'Snapshot 9' },
  { src: '/shots/IMG_20260721_184810.webp', alt: 'Snapshot 10' },
  { src: '/shots/IMG_20260808_175752.webp', alt: 'Snapshot 11' },
  { src: '/shots/IMG_20260808_175854.webp', alt: 'Snapshot 12' },
  { src: '/shots/IMG_20260808_175859.webp', alt: 'Snapshot 13' },
  { src: '/shots/IMG_20260811_181523.webp', alt: 'Snapshot 14' },
  { src: '/shots/IMG_20260811_182439.webp', alt: 'Snapshot 15' },
  { src: '/shots/IMG_20260827_185049.webp', alt: 'Snapshot 16' },
  { src: '/shots/IMG_20260913_174305.webp', alt: 'Snapshot 17' },
  { src: '/shots/IMG_20260913_174319.webp', alt: 'Snapshot 18' },
  { src: '/shots/IMG_20260913_174334.webp', alt: 'Snapshot 19' },
  { src: '/shots/IMG_20260926_175845.webp', alt: 'Snapshot 20' },
  { src: '/shots/IMG_20260926_180533.webp', alt: 'Snapshot 21' },
  { src: '/shots/IMG_20260926_180540.webp', alt: 'Snapshot 22' },
  { src: '/shots/IMG_20260926_180547.webp', alt: 'Snapshot 23' },
  { src: '/shots/IMG_20260926_180753.webp', alt: 'Snapshot 24' },
];

// Initial randomized order on render
const shuffledShots = [...shots].sort(() => Math.random() - 0.5);
---

<section class="py-[2.5rem] flex flex-col gap-[1.5rem]" data-gsap="snapshots">
  <div class="flex items-end justify-between">
    <div class="flex flex-col">
      <span class="text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-muted uppercase">Visual Journal</span>
      <h2 class="text-[24px] leading-[32px] tracking-[-0.02em] font-semibold text-text-primary">Snapshots</h2>
    </div>
  </div>

  <!-- Masonry Gallery Container with Progressive View More -->
  <div id="snapshots-wrapper" class="relative w-full pb-[90px] transition-[padding] duration-500">
    <!-- 3-Column Masonry Grid -->
    <div
      id="snapshots-masonry"
      class="columns-1 sm:columns-2 md:columns-3 gap-3 sm:gap-4 [column-fill:_balance]"
    >
      {shuffledShots.map((shot, index) => {
        // Initial SSR visibility: 2 on mobile (<640px), 6 (2 rows) on desktop (>=640px)
        const initialVisibility =
          index < 2 ? '' : index < 6 ? 'hidden sm:block' : 'hidden';

        return (
          <div
            class={`snapshot-item break-inside-avoid mb-3 sm:mb-4 group cursor-pointer relative overflow-hidden rounded-xl border border-neutral-200/80 bg-neutral-100 shadow-[0_2px_8px_rgba(0,0,0,0.03)] hover:shadow-lg hover:border-neutral-400/80 transition-all duration-300 ${initialVisibility}`}
            data-index={index}
            data-src={shot.src}
          >
            <img
              src={shot.src}
              alt={shot.alt}
              loading={index < 6 ? "eager" : "lazy"}
              class="w-full h-auto object-cover block group-hover:scale-[1.03] transition-transform duration-500 ease-out"
            />
          </div>
        );
      })}
    </div>

    <!-- Gradient Fade Overlay with View More Button (shifted 90px downside) -->
    <div
      id="snapshots-fade-overlay"
      class="absolute bottom-0 left-0 right-0 h-48 sm:h-56 pointer-events-none flex items-end justify-center pb-5 transition-all duration-500"
      style="background: linear-gradient(to bottom, rgba(250, 250, 250, 0) 0%, rgba(250, 250, 250, 0.7) 35%, #FAFAFA 68%, #FAFAFA 100%);"
    >
      <button
        id="snapshots-view-more-btn"
        type="button"
        class="pointer-events-auto inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#171717] text-white text-[13px] leading-[18px] tracking-[0.01em] font-medium border border-neutral-800 shadow-[0_4px_16px_rgba(0,0,0,0.18)] hover:bg-black hover:scale-[1.03] active:scale-[0.97] transition-all cursor-pointer select-none"
      >
        <span>View More</span>
        <span class="material-symbols-outlined text-[18px] transition-transform duration-200">
          expand_more
        </span>
      </button>
    </div>
  </div>
</section>

<!-- Lightbox Modal for Enlarged Photo Preview (Pure Image View, No Text Details) -->
<div
  id="snapshots-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Photo Preview"
>
  <div
    id="snapshots-modal-card"
    class="relative max-w-[92vw] max-h-[90vh] bg-transparent rounded-2xl overflow-hidden shadow-2xl flex flex-col items-center transform scale-95 transition-transform duration-300"
  >
    <button
      id="snapshots-modal-close"
      type="button"
      aria-label="Close photo preview"
      class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-black/70 text-white flex items-center justify-center hover:bg-black transition-colors cursor-pointer shadow-lg"
    >
      <span class="material-symbols-outlined text-[20px]">close</span>
    </button>

    <div class="relative w-auto max-h-[85vh] flex items-center justify-center rounded-2xl overflow-hidden border border-neutral-700/60 shadow-2xl bg-black">
      <img
        id="snapshots-modal-img"
        src=""
        alt="Enlarged snapshot"
        class="max-h-[85vh] w-auto max-w-full object-contain block"
      />
    </div>
  </div>
</div>

<style>
  @keyframes snapshot-fade-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-snapshot-fade {
    animation: snapshot-fade-in 450ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  function setupSnapshotsGallery() {
    const wrapper = document.getElementById('snapshots-wrapper');
    const masonry = document.getElementById('snapshots-masonry');
    const viewMoreBtn = document.getElementById('snapshots-view-more-btn');
    const fadeOverlay = document.getElementById('snapshots-fade-overlay');

    if (!masonry) return;

    // Lightbox modal elements
    const modal = document.getElementById('snapshots-modal');
    const modalCard = document.getElementById('snapshots-modal-card');
    const modalImg = document.getElementById('snapshots-modal-img') as HTMLImageElement;
    const modalClose = document.getElementById('snapshots-modal-close');

    const items = Array.from(masonry.querySelectorAll<HTMLElement>('.snapshot-item'));
    if (items.length === 0) return;

    // Always randomize images first (Fisher-Yates shuffle)
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }

    // Responsive initial count: 2 on mobile (<640px), 6 (2 rows) on desktop (>=640px)
    const isMobileQuery = window.matchMedia('(max-width: 639px)');
    let visibleCount = isMobileQuery.matches ? 2 : 6;

    const applyVisibility = (animateFrom = -1) => {
      items.forEach((item, index) => {
        item.classList.remove('sm:block');
        if (index < visibleCount) {
          item.classList.remove('hidden');
          if (animateFrom >= 0 && index >= animateFrom) {
            item.classList.add('animate-snapshot-fade');
          }
        } else {
          item.classList.add('hidden');
          item.classList.remove('animate-snapshot-fade');
        }
        masonry.appendChild(item);
      });

      if (viewMoreBtn && fadeOverlay) {
        if (visibleCount >= items.length) {
          fadeOverlay.classList.add('opacity-0', 'pointer-events-none');
          wrapper?.classList.remove('pb-[90px]');
          setTimeout(() => {
            fadeOverlay.style.display = 'none';
          }, 400);
        } else {
          wrapper?.classList.add('pb-[90px]');
          fadeOverlay.style.display = 'flex';
          fadeOverlay.classList.remove('opacity-0', 'pointer-events-none');
        }
      }
    };

    applyVisibility();

    // Progressive "View More" click handler: reveals 2 on mobile, 6 (2 rows) on desktop
    if (viewMoreBtn && fadeOverlay) {
      viewMoreBtn.onclick = () => {
        const batchSize = isMobileQuery.matches ? 2 : 6;
        const prevCount = visibleCount;
        visibleCount = Math.min(items.length, visibleCount + batchSize);
        applyVisibility(prevCount);
      };
    }

    // Viewport resize/orientation change listener
    isMobileQuery.addEventListener('change', (e) => {
      if (!e.matches && visibleCount < 6) {
        visibleCount = 6;
        applyVisibility();
      }
    });

    // Lightbox modal functions
    function openModal(src: string) {
      if (!modal || !modalImg) return;
      modalImg.src = src;

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modalCard?.classList.remove('scale-95');
      modalCard?.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalCard?.classList.remove('scale-100');
      modalCard?.classList.add('scale-95');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (modalImg) modalImg.src = '';
      }, 300);
    }

    // Attach click listeners to all snapshot cards
    items.forEach((item) => {
      item.onclick = () => {
        const src = item.dataset.src || '';
        if (src) openModal(src);
      };
    });

    if (modalClose) modalClose.onclick = closeModal;
    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) closeModal();
      };
    }

    document.onkeydown = (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('opacity-0')) {
        closeModal();
      }
    };
  }

  setupSnapshotsGallery();
  document.addEventListener('astro:page-load', setupSnapshotsGallery);
</script>
