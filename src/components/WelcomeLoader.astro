---
// src/components/WelcomeLoader.astro
import WelcomeCalligraphy from './WelcomeCalligraphy.astro';
---

<div
  id="welcome-loader"
  class="fixed inset-0 z-40 flex items-center justify-center select-none pointer-events-none"
  aria-label="Welcome loader"
>
  <div class="welcome-loader-content w-full flex flex-col items-center justify-center px-4 sm:px-6">
    <WelcomeCalligraphy width="min(94vw, 780px)" duration={1.05} replayOnClick={false} />
  </div>
</div>

<script>
  import gsap from 'gsap';

  function initWelcomeLoader() {
    const loader = document.getElementById('welcome-loader');
    const mainContent = document.getElementById('main-content');
    if (!loader || !mainContent) return;

    // Prevent scrolling while welcome loader is active
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    // Random duration between 3.0s and 4.5s (3000ms - 4500ms)
    const randomDurationMs = 3000 + Math.random() * 1500;

    window.setTimeout(() => {
      // Mark loader as completed so Animations.astro knows to proceed immediately
      loader.dataset.done = 'true';

      // Unlock scrolling
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';

      // Smoothly blur and fade out the welcome calligraphy
      gsap.to(loader, {
        opacity: 0,
        filter: 'blur(10px)',
        scale: 0.96,
        duration: 0.65,
        ease: 'power2.inOut',
        onComplete: () => {
          loader.style.display = 'none';
        },
      });

      // Smoothly reveal the main content container
      mainContent.style.visibility = 'visible';
      mainContent.classList.remove('invisible', 'pointer-events-none');
      gsap.to(mainContent, {
        opacity: 1,
        duration: 0.6,
        ease: 'power2.out',
        onStart: () => {
          mainContent.style.pointerEvents = 'auto';
          // Notify Animations.astro to start the portfolio entrance animations
          window.dispatchEvent(new CustomEvent('welcome-loader-finished'));
        },
      });
    }, randomDurationMs);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWelcomeLoader, { once: true });
  } else {
    initWelcomeLoader();
  }
</script>
