---
// Games Section - Interactive List with Gliding Highlight & Floating Poster Preview
const games = [
  { title: 'Grand Theft Auto V', year: '2026', img: '/games/gta-5.webp' },
  { title: '007: First Light', year: '2026', img: '/games/first-light-007.webp' },
  { title: 'Shadow of the Tomb Raider', year: '2026', img: '/games/shadow-of-the-tomb-raider.webp' },
  { title: 'God of War Ragnarök', year: '2026', img: '/games/god-of-war-ragnarok.webp' },
  { title: 'God of War (2018)', year: '2026', img: '/games/god-of-war-2018.webp' },
  { title: 'The Last of Us Part I', year: '2025', img: '/games/last-of-us-1.webp' },
  { title: 'Rise of the Tomb Raider', year: '2025', img: '/games/rise-of-the-tomb-raider.webp' },
  { title: 'Tomb Raider (2013)', year: '2025', img: '/games/tomb-raider-2013.webp' },
];
---

<section class="py-[2.5rem] flex flex-col gap-[1.5rem]" data-gsap="games">
  <div class="flex items-end justify-between">
    <div class="flex flex-col">
      <span class="text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-muted uppercase">Interactive Medium</span>
      <h2 class="text-[24px] leading-[32px] tracking-[-0.02em] font-semibold text-text-primary">Games I Have Played</h2>
    </div>
  </div>

  <div id="games-list-wrapper" class="relative flex flex-col border-t border-neutral-200/80">
    <!-- Gliding highlight bar -->
    <div
      id="games-hover-pill"
      class="absolute top-0 left-0 right-0 bg-[#171717] pointer-events-none opacity-0 z-0"
      style="will-change: transform, opacity;"
    ></div>

    {games.map((game, i) => (
      <div
        class="game-row relative z-10 flex items-center justify-between py-4 px-3 sm:px-4 border-b border-neutral-200/80 cursor-pointer select-none"
        data-index={i}
      >
        <div class="flex items-center gap-3">
          <span class="game-title text-[15px] sm:text-[16px] font-semibold text-text-primary">
            {game.title}
          </span>
        </div>
        <div class="flex items-center gap-3">
          <span class="game-year text-[13px] font-mono font-medium text-text-muted">
            {game.year}
          </span>
          <span class="game-arrow material-symbols-outlined text-[15px] text-text-muted opacity-0">
            arrow_forward
          </span>
        </div>
      </div>
    ))}
  </div>

  <!-- Floating preview card: all posters are mounted once, we only toggle visibility -->
  <div
    id="game-floating-card"
    class="pointer-events-none fixed top-0 left-0 z-50 w-[170px] sm:w-[195px] aspect-[3/4] rounded-xl overflow-hidden shadow-[0_20px_40px_-8px_rgba(0,0,0,0.28),0_6px_14px_rgba(0,0,0,0.12)] border-[2.5px] border-white bg-neutral-900 opacity-0"
    style="will-change: transform, opacity; backface-visibility: hidden;"
    aria-hidden="true"
  >
    {games.map((game, i) => (
      <img
        class="game-poster absolute inset-0 w-full h-full object-cover"
        data-index={i}
        src={game.img}
        alt=""
        width="390"
        height="520"
        loading="eager"
        decoding="async"
        draggable="false"
      />
    ))}
  </div>
</section>

<style>
  .game-poster {
    visibility: hidden;
  }
  .game-poster.is-active {
    visibility: visible;
  }

  .game-row .game-title,
  .game-row .game-year,
  .game-row .game-arrow {
    transition: color 220ms ease-out, opacity 220ms ease-out, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .game-row[data-active="true"] .game-title {
    color: #ffffff;
  }

  .game-row[data-active="true"] .game-year {
    color: #d4d4d4;
  }

  .game-row[data-active="true"] .game-arrow {
    opacity: 1;
    transform: translateX(3px);
    color: #ffffff;
  }
</style>

<script>
  import gsap from 'gsap';
  import { playTapSound } from '../utils/sound';

  let cleanup: (() => void) | null = null;

  function setupGameHover() {
    // Tear down any previous init (Astro fires page-load on first load + every navigation)
    cleanup?.();
    cleanup = null;

    const wrapper = document.getElementById('games-list-wrapper');
    const pill = document.getElementById('games-hover-pill');
    const card = document.getElementById('game-floating-card');
    if (!wrapper || !pill || !card) return;

    // No hover preview on touch devices
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rows = Array.from(wrapper.querySelectorAll<HTMLElement>('.game-row'));
    const posters = Array.from(card.querySelectorAll<HTMLElement>('.game-poster'));
    if (!rows.length) return;

    const ac = new AbortController();
    const { signal } = ac;

    // ---- State ----
    let activeRow: HTMLElement | null = null;
    let visible = false;
    let ticking = false;

    let tx = 0, ty = 0;        // target position (from cursor)
    let cx = 0, cy = 0;        // current (smoothed) position
    let rot = 0;               // current rotation
    let lastPX = 0, lastPY = 0; // last pointer coords (for scroll re-hit-testing)

    let cardW = card.offsetWidth;
    let cardH = card.offsetHeight;

    const setX = gsap.quickSetter(card, 'x', 'px') as (v: number) => void;
    const setY = gsap.quickSetter(card, 'y', 'px') as (v: number) => void;
    const setR = gsap.quickSetter(card, 'rotation', 'deg') as (v: number) => void;

    gsap.set(card, { opacity: 0, scale: 0.9, x: 0, y: 0, rotation: 0, transformOrigin: 'center center' });

    const measure = () => {
      cardW = card.offsetWidth;
      cardH = card.offsetHeight;
    };
    window.addEventListener('resize', measure, { signal, passive: true });

    // ---- Card follow loop (frame-rate independent, runs only while visible) ----
    const tick = () => {
      const dt = gsap.ticker.deltaRatio(); // 1 at 60fps, 0.5 at 120fps, etc.
      const follow = reduceMotion ? 1 : 1 - Math.pow(1 - 0.14, dt);
      const tiltEase = 1 - Math.pow(1 - 0.1, dt);

      const prevX = cx;
      cx += (tx - cx) * follow;
      cy += (ty - cy) * follow;

      // Tilt from real velocity, so it eases back to 0 naturally when you stop
      const vx = cx - prevX;
      const targetRot = reduceMotion ? 0 : Math.max(-8, Math.min(8, vx * 0.5));
      rot += (targetRot - rot) * tiltEase;

      setX(cx);
      setY(cy);
      setR(rot);
    };

    const startTicker = () => {
      if (ticking) return;
      ticking = true;
      gsap.ticker.add(tick);
    };
    const stopTicker = () => {
      if (!ticking) return;
      ticking = false;
      gsap.ticker.remove(tick);
    };

    // ---- Helpers ----
    const updateTarget = (clientX: number, clientY: number) => {
      const GAP = 24;
      const PAD = 16;

      let x = clientX + GAP;
      let y = clientY - cardH / 2;

      // Flip to the left of the cursor near the right edge
      if (x + cardW > window.innerWidth - PAD) x = clientX - cardW - GAP;
      x = Math.max(PAD, x);
      y = Math.max(PAD, Math.min(y, window.innerHeight - cardH - PAD));

      tx = x;
      ty = y;
    };

    const setPoster = (index: number) => {
      posters.forEach((p, i) => p.classList.toggle('is-active', i === index));
    };

    const activate = (row: HTMLElement) => {
      if (row === activeRow) return;

      activeRow?.removeAttribute('data-active');
      row.setAttribute('data-active', 'true');
      activeRow = row;

      playTapSound();

      setPoster(Number(row.dataset.index));

      const y = row.offsetTop;
      const height = row.offsetHeight;

      if (!visible) {
        // First appearance: snap into place, fade in
        visible = true;

        gsap.set(pill, { y, height });
        gsap.to(pill, { opacity: 1, duration: 0.2, ease: 'power2.out', overwrite: 'auto' });

        cx = tx;
        cy = ty;
        rot = 0;
        setX(cx);
        setY(cy);
        setR(0);
        startTicker();

        gsap.to(card, {
          opacity: 1,
          scale: 1,
          duration: reduceMotion ? 0 : 0.35,
          ease: 'power3.out',
          overwrite: 'auto',
        });
      } else {
        // Smooth glide between rows: fast start, long soft tail
        gsap.to(pill, {
          y,
          height,
          duration: reduceMotion ? 0 : 0.55,
          ease: 'expo.out',
          overwrite: 'auto',
        });
      }
    };

    const hide = () => {
      if (!visible) return;
      visible = false;

      activeRow?.removeAttribute('data-active');
      activeRow = null;

      gsap.to(pill, { opacity: 0, duration: 0.2, ease: 'power2.out', overwrite: 'auto' });
      gsap.to(card, {
        opacity: 0,
        scale: 0.9,
        duration: 0.2,
        ease: 'power2.out',
        overwrite: 'auto',
        onComplete: () => {
          if (!visible) stopTicker();
        },
      });
    };

    // ---- Events (one delegated listener instead of 2 per row) ----
    wrapper.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;

        lastPX = e.clientX;
        lastPY = e.clientY;
        updateTarget(e.clientX, e.clientY);

        const row = (e.target as HTMLElement).closest<HTMLElement>('.game-row');
        if (row) activate(row);
      },
      { signal, passive: true }
    );

    wrapper.addEventListener('pointerleave', hide, { signal });
    document.documentElement.addEventListener('mouseleave', hide, { signal });
    window.addEventListener('blur', hide, { signal });

    // Keep hover correct while scrolling with a stationary cursor
    let scrollRaf = 0;
    window.addEventListener(
      'scroll',
      () => {
        if (!visible || scrollRaf) return;
        scrollRaf = requestAnimationFrame(() => {
          scrollRaf = 0;
          const el = document.elementFromPoint(lastPX, lastPY);
          const row = el?.closest<HTMLElement>('.game-row');
          if (row && wrapper.contains(row)) activate(row);
          else hide();
        });
      },
      { signal, passive: true }
    );

    cleanup = () => {
      ac.abort();
      stopTicker();
      cancelAnimationFrame(scrollRaf);
      gsap.killTweensOf([pill, card]);
    };
  }

  setupGameHover();
  document.addEventListener('astro:page-load', setupGameHover);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>