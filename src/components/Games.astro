<section class="py-[2.5rem] flex flex-col gap-[1.5rem]" data-gsap="games">
  <div class="flex items-end justify-between">
    <div class="flex flex-col">
      <span class="text-[11px] leading-[16px] tracking-[0.04em] font-semibold text-text-muted uppercase">Interactive Medium</span>
      <h2 class="text-[24px] leading-[32px] tracking-[-0.02em] font-semibold text-text-primary">Games I Have Played</h2>
    </div>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 sm:gap-3.5">
    {games.map(game => (
      <div class="group flex flex-col gap-2">
        <div class="relative aspect-[3/4] rounded-lg overflow-hidden bg-neutral-900 border border-neutral-200/80 shadow-[0_2px_8px_rgba(0,0,0,0.06)] group-hover:shadow-[0_8px_20px_rgba(0,0,0,0.14)] group-hover:-translate-y-1 transition-all duration-200">
          <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" alt={game.title} src={game.img} />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>
        <div class="flex flex-col">
          <h3 class="text-[13px] sm:text-[14px] font-semibold leading-tight text-text-primary group-hover:text-black transition-colors">{game.title}</h3>
          <span class="text-[12px] text-text-muted">{game.studio}</span>
        </div>
      </div>
    ))}
  </div>
</section>
